Persist the whole panic console transcript to the partition log tail, not
just the zalloc_uaf element. While panic_active() every _cnputs appends to a
static buffer and rewrites the SWEETPAN record, so pmap/assert panics leave
their string + backtrace readable from recovery instead of only ~10 screen
lines.

diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index 3927e7a..7c5e3f5 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -962,6 +962,34 @@ sweet_ufs_panic_write(const char *tag, const void *data, size_t len)
 	return ufs_write_blocks(base, 1 + (uint32_t)((len + UFS_BLOCK - 1) / UFS_BLOCK));
 }
 
+/* SWEET: while panicking, accumulate the console transcript into a static
+ * buffer and rewrite the panic record with the growing text on every write.
+ * Called from _cnputs (panic context, interrupts off); ufs_write_blocks is
+ * polled so this runs with the other CPUs quiesced. Self-guarded: no-op
+ * outside panic and before the UFS host/partition are up. */
+extern int panic_active(void);
+#define SWEET_PANIC_TEXT_SIZE (256u << 10)
+static char sweet_panic_text[SWEET_PANIC_TEXT_SIZE];
+static size_t sweet_panic_len;
+
+void
+sweet_panic_log_append(const char *c, int size)
+{
+	if (!panic_active() || size <= 0) {
+		return;
+	}
+	size_t n = (size_t)size;
+	if (n > sizeof(sweet_panic_text) - sweet_panic_len) {
+		n = sizeof(sweet_panic_text) - sweet_panic_len;
+	}
+	if (n) {
+		memcpy(sweet_panic_text + sweet_panic_len, c, n);
+		sweet_panic_len += n;
+		sweet_ufs_panic_write("console-panic", sweet_panic_text,
+		    sweet_panic_len);
+	}
+}
+
 struct sweet_log_header {
 	char magic[8];
 	uint32_t version, size;
diff --git a/osfmk/console/serial_console.c b/osfmk/console/serial_console.c
index c86b9e7..4cefb41 100644
--- a/osfmk/console/serial_console.c
+++ b/osfmk/console/serial_console.c
@@ -268,6 +268,7 @@ _cnputc(char c, bool poll)
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 extern void sweet_log_append(const char *c, int size);  /* bsd/dev/sweet_ufs.c */
+extern void sweet_panic_log_append(const char *c, int size);  /* bsd/dev/sweet_ufs.c */
 /*
  * Set by AppleCLCD (boot-arg sweetfb_noconsole=1) once the GUI presents:
  * console text still goes to the persistent log, but is not drawn over
@@ -283,6 +284,7 @@ _cnputs(char *c, int size, bool poll)
 
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 	sweet_log_append(c, size);
+	sweet_panic_log_append(c, size);
 	if (sweet_console_muted && !panic_active()) {
 		return;
 	}
