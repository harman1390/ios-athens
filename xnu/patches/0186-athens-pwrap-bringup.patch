+/*
+ * ================= athens (MT6853) pwrap bring-up =================
+ * Ported from the vendor mt6785 pwrap HAL
+ * (drivers/misc/mediatek/pmic_wrap/mt6785/pwrap_hal.c + pwrap_hal.h,
+ * MTK_PLATFORM_MT6359) and clk-mt6853.c. lk2nd leaves the wrapper
+ * unclocked and uninitialised; Android's CCF enables the spi/wrap gates and
+ * pwrap_init() runs the sequence below. We replicate it with direct MMIO.
+ * The WACS2 register offsets and command format are identical to the ones
+ * this file already uses (verified against mt6785/pwrap_hal.h).
+ */
+
+/* infracfg_ao (syson@10001000) - clk-mt6853.c *_cg_regs + mt6785 hal.h */
+#define AT_IFRAO_CG0_SET    0x080   /* MODULE_SW_CG_0_SET : ifrao2 set   */
+#define AT_IFRAO_CG0_CLR    0x084   /* MODULE_SW_CG_0_CLR : ifrao2 clr   */
+#define AT_IFRAO_CG0_STA    0x090   /* ifrao2 status                    */
+#define AT_IFRAO_CG2_SET    0x0a4   /* MODULE_SW_CG_2_SET : ifrao4 set   */
+#define AT_IFRAO_CG2_CLR    0x0a8   /* MODULE_SW_CG_2_CLR : ifrao4 clr   */
+#define AT_PMICW_CLK_CTRL   0x3ac   /* PMICW_CLOCK_CTRL_CLR             */
+#define AT_INFRA_RST2_SET   0x140   /* INFRA_GLOBALCON_RST2_SET         */
+#define AT_INFRA_RST2_CLR   0x144   /* INFRA_GLOBALCON_RST2_CLR         */
+
+/* topckgen (0x10000000) - clk-mt6853.c CLK_CFG_8: pwrap_ulposc_sel mux */
+#define AT_CLK_CFG_8        0x090
+#define AT_ULPOSC_SEL_SHIFT 2
+
+/* pwrap register offsets (mt6785 pwrap_hal.h; base = fRegs) */
+#define PW_MUX_SEL          0x000
+#define PW_WRAP_EN          0x004
+#define PW_DIO_EN           0x008
+#define PW_SI_SAMPLE_CTRL   0x00c
+#define PW_SI_SAMPLE_CTRL_ULPOSC 0x01c
+#define PW_RDDMY            0x020
+#define PW_CSHEXT_WRITE     0x024
+#define PW_CSHEXT_READ      0x028
+#define PW_CSLEXT_WRITE     0x02c
+#define PW_CSLEXT_READ      0x030
+#define PW_EXT_CK_WRITE     0x034
+#define PW_EXT_CK_READ      0x038
+#define PW_STAUPD_CTRL      0x03c
+#define PW_STAUPD_GRPEN     0x040
+#define PW_WRAP_STA         0x060
+#define PW_HARB_HPRIO       0x068
+#define PW_HPRIO_ARB_EN     0x06c
+#define PW_MAN_EN           0x07c
+#define PW_MAN_CMD          0x080
+#define PW_MAN_RDATA        0x084
+#define PW_MAN_VLDCLR       0x088
+#define PW_WACS0_EN         0x08c
+#define PW_WACS1_EN         0x094
+#define PW_WACS2_EN         0x09c
+#define PW_WACS3_EN         0x0a4
+#define PW_WACS_P2P_EN      0x0ac
+#define PW_WACS_MD32_EN     0x0b4
+#define PW_INIT_DONE0       0x090
+#define PW_INIT_DONE1       0x098
+#define PW_INIT_DONE2       0x0a0
+#define PW_INIT_DONE3       0x0a8
+#define PW_INIT_DONE_P2P    0x0b0
+#define PW_INIT_DONE_MD32   0x0b8
+#define PW_INT0_EN          0x0bc
+#define PW_INT1_EN          0x0cc
+#define PW_TIMER_CTRL       0x0f0
+#define PW_WDT_CTRL         0x0f8
+#define PW_WDT_SRC_EN_0     0x0fc
+#define PW_WDT_SRC_EN_1     0x100
+#define PW_SW_RESET         0x2a8
+#define PW_WACS2_CMD        0xc20
+#define PW_WACS2_RDATA      0xc24
+#define PW_WACS2_VLDCLR     0xc28
+
+/* bit fields (mt6785 pwrap_hal.h GET_* macros) */
+#define W2_RDATA(x)     ((x) & 0xffff)
+#define W2_FSM(x)       (((x) >> 16) & 7)
+#define W2_SYNC(x)      (((x) >> 20) & 1)
+#define W2_INITDONE(x)  (((x) >> 22) & 1)
+#define WRAP_FSM(x)     (((x) >> 11) & 0xf)
+#define WRAP_DLE(x)     ((x) & 7)
+#define MAN_FSM(x)      (((x) >> 8) & 7)
+
+/* manual-mode OP codes + FSM values (mt6785 pwrap_hal.h) */
+#define OP_WR           0x1
+#define OP_CSH          0x0
+#define OP_CSL          0x1
+#define OP_OUTS         0x8
+#define FSM_IDLE        0
+#define FSM_WFVLDCLR    6
+#define SYNC_IDLE       1
+#define MANUAL_MODE     1
+#define WRAPPER_MODE    0
+
+/* PMIC (MT6359) SPI register addresses - mt6853 upmu_hw.h (base 0) */
+#define PMIC_DEW_DIO_EN        0x40c
+#define PMIC_DEW_READ_TEST     0x40e
+#define PMIC_DEW_WRITE_TEST    0x410
+#define PMIC_DEW_RDDMY_NO      0x424
+#define PMIC_RG_SPI_DLY_SEL    0x426
+#define PMIC_RG_SMT_SPI_CLK    0x32
+#define PMIC_GPIO_PULLEN0_CLR  0x98
+#define PMIC_RG_SPI_MISO_MODE  0x408
+#define PMIC_RG_OCTL_SPI_CLK   0x3a
+#define PMIC_RG_SRCLKEN_IN0    0x42
+#define PMIC_SPISLV_KEY        0x44a
+
