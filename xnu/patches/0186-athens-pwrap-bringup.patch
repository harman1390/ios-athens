+/*
+ * _pwrap_wacs2_nochk (mt6785 pwrap_hal.c): a raw WACS2 transaction with no
+ * init-done / sync check - used by pwrap_init() itself before the wrapper is
+ * up. Identical command format to readPMIC/writePMIC.
+ */
+IOReturn
+VivaPwrap::wacs2NoChk(uint32_t write, uint32_t addr, uint32_t wdata, uint32_t *rdata)
+{
+	if (rdata) {
+		*rdata = 0;
+	}
+	if (addr > 0xffff || wdata > 0xffff || (!write && rdata == NULL)) {
+		return kIOReturnBadArgument;
+	}
+	IOReturn ret = kIOReturnTimeout;
+	IOLockLock(fLock);
+	if (waitFSM(WACS_FSM_IDLE)) {
+		wr32(PW_WACS2_CMD, (write ? 0x80000000u : 0) | ((addr >> 1) << 16) | wdata);
+		if (write) {
+			ret = kIOReturnSuccess;
+		} else if (waitFSM(WACS_FSM_WFVLDCLR)) {
+			*rdata = rd32(PW_WACS2_RDATA) & 0xffff;
+			wr32(PW_WACS2_VLDCLR, 1);
+			ret = kIOReturnSuccess;
+		}
+	}
+	IOLockUnlock(fLock);
+	return ret;
+}
+
+/*
+ * athens (MT6853) pwrap bring-up - faithful port of pwrap_init() from the
+ * vendor mt6785 pwrap HAL (MT6359-class). lk2nd does not run this, so the
+ * spi/wrap clocks are gated and the WACS2 engine is uninitialised. Each stage
+ * is logged so a failure pinpoints the exact step. _pwrap_InitStaUpd() and
+ * _pwrap_starve_set() (status-update/auxadc/starvation, not needed for plain
+ * register access) are intentionally omitted for now.
+ */
+void
+VivaPwrap::athensPwrapInit(void)
+{
+	uint32_t r = 0;
+	int i, found, si_en_sel, si_ck_sel, si_dly, si_sample_ctrl, clk_edge_no;
+	static const uint32_t test_data[30] = {
+		0x6996, 0x9669, 0x6996, 0x9669, 0x6996, 0x9669, 0x6996, 0x9669, 0x6996, 0x9669,
+		0x5aa5, 0xa55a, 0x5aa5, 0xa55a, 0x5aa5, 0xa55a, 0x5aa5, 0xa55a, 0x5aa5, 0xa55a,
+		0x1b27, 0x1b27, 0x1b27, 0x1b27, 0x1b27, 0x1b27, 0x1b27, 0x1b27, 0x1b27, 0x1b27,
+	};
+
+	if (fInfraRegs == 0) {
+		IOLog("VIVA PWRAP: no infracfg map - cannot enable clocks\n");
+		return;
+	}
+	IOLog("VIVA PWRAP: athens init; pre ifrao2_sta 0x%x clk_cfg8 0x%x wrap_en 0x%x\n",
+	    infraRd(AT_IFRAO_CG0_STA), fTopRegs ? topRd(AT_CLK_CFG_8) : 0, rd32(PW_WRAP_EN));
+
+	/* 1. __pwrap_spi_clk_set: gate spi/wrap clocks, drop the SPM 26M ctrl,
+	 *    soft-reset pwrap, then ungate -> a clean clock restart. The ifrao2
+	 *    gates are active-low: STA=1 gated, a CLR write enables. */
+	infraWr(AT_IFRAO_CG0_SET, 0xf);
+	infraWr(AT_IFRAO_CG2_SET, 0x100);
+	infraWr(AT_PMICW_CLK_CTRL, 0x2);
+	infraWr(AT_INFRA_RST2_SET, 1);
+	infraWr(AT_INFRA_RST2_CLR, 1);
+	infraWr(AT_IFRAO_CG0_CLR, 0xf);
+	infraWr(AT_IFRAO_CG2_CLR, 0x100);
+	IODelay(100);
+	IOLog("VIVA PWRAP: clocks on, ifrao2_sta 0x%x (0=running)\n", infraRd(AT_IFRAO_CG0_STA));
+
+	/* 2. _pwrap_reset_spislv: manual-mode bit-bang to reset the SPI slave. */
+	wr32(PW_HPRIO_ARB_EN, 0);
+	wr32(PW_WRAP_EN, 0);
+	wr32(PW_MUX_SEL, MANUAL_MODE);
+	wr32(PW_MAN_EN, 1);
+	wr32(PW_DIO_EN, 0);
+	wr32(PW_MAN_CMD, (OP_WR << 13) | (OP_CSL << 8));
+	wr32(PW_MAN_CMD, (OP_WR << 13) | (OP_OUTS << 8));
+	wr32(PW_MAN_CMD, (OP_WR << 13) | (OP_CSH << 8));
+	for (i = 0; i < 4; i++) {                    /* CSL OUTS CSH OUTS x4 */
+		wr32(PW_MAN_CMD, (OP_WR << 13) | (OP_OUTS << 8));
+	}
+	for (i = 0; i < 1000; i++) {                 /* wait_for_sync: SYNC_IDLE2 */
+		if (W2_SYNC(rd32(PW_WACS2_RDATA)) == SYNC_IDLE) {
+			break;
+		}
+		IODelay(1);
+	}
+	wr32(PW_MAN_EN, 0);
+	wr32(PW_MUX_SEL, WRAPPER_MODE);
+	IOLog("VIVA PWRAP: spislv reset done\n");
+
+	/* 3. enable wrapper + WACS2 + WACS2-only arbitration */
+	wr32(PW_WRAP_EN, 1);
+	wr32(PW_WACS2_EN, 1);
+	wr32(PW_HPRIO_ARB_EN, 0x4);
+	IODelay(100);
+
+	/* 4. _pwrap_init_reg_clock(1): external clock write + PMIC dummy reads */
+	wr32(PW_EXT_CK_WRITE, 1);
+	wacs2NoChk(1, PMIC_DEW_RDDMY_NO, 0x8, NULL);
+	wr32(PW_RDDMY, 0x8);
+	wr32(PW_CSHEXT_WRITE, 0);
+	wr32(PW_CSHEXT_READ, 0);
+	wr32(PW_CSLEXT_WRITE, 0);
+	wr32(PW_CSLEXT_READ, 0x0200);
+	IOLog("VIVA PWRAP: reg_clock done\n");
+
+	/* liveness probe: does a WACS2 read complete (FSM reaches WFVLDCLR)?
+	 * Data need not be 0x5aa5 yet (sistrobe calibrates the SI phase), but a
+	 * completed transaction proves the engine+clock are alive. A timeout
+	 * means dead - abort before the long calibration sweeps. */
+	{
+		IOReturn lr = wacs2NoChk(0, PMIC_DEW_READ_TEST, 0, &r);
+		IOLog("VIVA PWRAP: post-regclock read_test ret %d rdata 0x%x\n", (int)lr, r);
+		if (lr != kIOReturnSuccess) {
+			IOLog("VIVA PWRAP: WACS2 dead after reg_clock - aborting init\n");
+			return;
+		}
+	}
+
+	/* 5. __pwrap_InitSPISLV: PMIC SPI slave configuration */
+	wacs2NoChk(1, PMIC_RG_SRCLKEN_IN0, 0xf0, NULL);
+	wacs2NoChk(1, PMIC_RG_SMT_SPI_CLK, 0xf, NULL);
+	wacs2NoChk(1, PMIC_GPIO_PULLEN0_CLR, 0xf0, NULL);
+	wacs2NoChk(1, PMIC_RG_SPI_MISO_MODE, 0x1, NULL);
+	wacs2NoChk(1, PMIC_RG_OCTL_SPI_CLK, 0x8888, NULL);
+	IOLog("VIVA PWRAP: spislv init done\n");
+
+	/* 6. _pwrap_init_dio(1): enable DIO (double-data-rate) mode */
+	wr32(PW_HPRIO_ARB_EN, 0x4);
+	for (i = 0; i < 1000; i++) {                 /* wait WRAP_FSM idle */
+		uint32_t st = rd32(PW_WRAP_STA);
+		if (WRAP_FSM(st) == 0 && WRAP_DLE(st) == 0) {
+			break;
+		}
+		IODelay(1);
+	}
+	wacs2NoChk(1, PMIC_DEW_DIO_EN, 1, NULL);
+	for (i = 0; i < 1000; i++) {                 /* wait WACS2 idle + sync */
+		uint32_t x = rd32(PW_WACS2_RDATA);
+		if (W2_FSM(x) == FSM_IDLE && W2_SYNC(x) == SYNC_IDLE) {
+			break;
+		}
+		IODelay(1);
+	}
+	wr32(PW_DIO_EN, 1);
+	IOLog("VIVA PWRAP: dio on\n");
+
+	/* 7. _pwrap_init_sistrobe(0): SI strobe calibration */
+	found = 0;
+	si_sample_ctrl = 0;
+	for (si_en_sel = 0; si_en_sel < 8; si_en_sel++) {
+		for (si_ck_sel = 0; si_ck_sel < 2; si_ck_sel++) {
+			si_sample_ctrl = (si_en_sel << 6) | (si_ck_sel << 5);
+			wr32(PW_SI_SAMPLE_CTRL, si_sample_ctrl);
+			wacs2NoChk(0, PMIC_DEW_READ_TEST, 0, &r);
+			if (r == 0x5aa5) {
+				found = 1;
+				break;
+			}
+		}
+		if (found) {
+			break;
+		}
+	}
+	IOLog("VIVA PWRAP: sistrobe sample en %d ck %d ctrl 0x%x rdata 0x%x\n",
+	    si_en_sel, si_ck_sel, si_sample_ctrl, r);
+
+	/* SI data-line delay sweep: find the write/read boundary */
+	for (si_dly = 0; si_dly < 10; si_dly++) {
+		wacs2NoChk(1, PMIC_RG_SPI_DLY_SEL, si_dly, NULL);
+		found = 0;
+		for (i = 0; i < 30; i++) {
+			wacs2NoChk(1, PMIC_DEW_WRITE_TEST, test_data[i], NULL);
+			wacs2NoChk(0, PMIC_DEW_WRITE_TEST, 0, &r);
+			if ((r & 0x7fff) != (test_data[i] & 0x7fff)) {
+				found = 1;
+				break;
+			}
+		}
+		if (found) {
+			break;
+		}
+	}
+	IOLog("VIVA PWRAP: sistrobe dly %d\n", si_dly);
+
+	si_sample_ctrl += 0x20;                       /* non-FPGA */
+	wr32(PW_SI_SAMPLE_CTRL, si_sample_ctrl);
+	if (si_dly == 10) {
+		si_dly--;
+	}
+
+	/* ULPOSC calibration (PMIC_WRAP_ULPOSC_CAL) */
+	si_en_sel = (rd32(PW_SI_SAMPLE_CTRL) << 23) >> 29;
+	si_ck_sel = (rd32(PW_SI_SAMPLE_CTRL) << 26) >> 31;
+	clk_edge_no = (((si_en_sel * 2 + si_ck_sel) * 100) * 3846 / 3846 + 50) / 100;
+	si_en_sel = clk_edge_no / 2;
+	si_ck_sel = clk_edge_no % 2;
+	si_sample_ctrl = (1 << 19) | (si_en_sel << 6) | (si_ck_sel << 5);
+	wr32(PW_SI_SAMPLE_CTRL_ULPOSC, si_sample_ctrl);
+	IOLog("VIVA PWRAP: sistrobe ulposc ctrl 0x%x\n", si_sample_ctrl);
+
+	/* read test */
+	wacs2NoChk(0, PMIC_DEW_READ_TEST, 0, &r);
+	IOLog("VIVA PWRAP: sistrobe read_test rdata 0x%x (want 5aa5)\n", r);
+
+	/* 8. _pwrap_wacs2_write_test(0) */
+	wacs2NoChk(1, PMIC_DEW_WRITE_TEST, 0xa55a, NULL);
+	wacs2NoChk(0, PMIC_DEW_WRITE_TEST, 0, &r);
+	IOLog("VIVA PWRAP: wacs2 write_test rdata 0x%x (want a55a)\n", r);
+
+	/* 9. _pwrap_enable: full arbitration + all WACS channels */
+	wr32(PW_HPRIO_ARB_EN, 0xfbb7f);
+	wr32(PW_WACS0_EN, 1);
+	wr32(PW_WACS1_EN, 1);
+	wr32(PW_WACS2_EN, 1);
+	wr32(PW_WACS3_EN, 1);
+	wr32(PW_WACS_P2P_EN, 1);
+	wr32(PW_WACS_MD32_EN, 1);
+	wr32(PW_STAUPD_CTRL, 5);
+	wr32(PW_WDT_CTRL, 0x3f);
+	wr32(PW_WDT_SRC_EN_0, 0xffffffff);
+	wr32(PW_WDT_SRC_EN_1, 0xffffffff);
+	wr32(PW_TIMER_CTRL, 3);
+	wr32(PW_INT0_EN, 0xffffffff);
+	wr32(PW_INT1_EN, 0x1fff);
+	IODelay(1000);
+
+	/* 10. Initialization Done */
+	wr32(PW_INIT_DONE0, 1);
+	wr32(PW_INIT_DONE1, 1);
+	wr32(PW_INIT_DONE2, 1);
+	wr32(PW_INIT_DONE3, 1);
+	wr32(PW_INIT_DONE_P2P, 1);
+	wr32(PW_INIT_DONE_MD32, 1);
+	IODelay(1000);
+
+	/* 11. _pwrap_lock_SPISLVReg: lock the PMIC SPI slave registers */
+	wacs2NoChk(1, PMIC_SPISLV_KEY, 0, NULL);
+
+	IOLog("VIVA PWRAP: athens init complete; wacs2_rdata 0x%x\n", rd32(PW_WACS2_RDATA));
+}
+
 IOReturn
 VivaPwrap::readPMIC(uint32_t addr, uint32_t *value)
 {
diff --git a/iokit/Kernel/arm/VivaPMIC.h b/iokit/Kernel/arm/VivaPMIC.h
--- a/iokit/Kernel/arm/VivaPMIC.h
+++ b/iokit/Kernel/arm/VivaPMIC.h
@@ -45,9 +45,17 @@
 	bool waitFSM(uint32_t fsm);
 	inline uint32_t rd32(uint32_t off) { return *(volatile uint32_t *)(fRegs + off); }
 	inline void wr32(uint32_t off, uint32_t v) { *(volatile uint32_t *)(fRegs + off) = v; }
+	/* athens (MT6853) pwrap bring-up: raw WACS2 transaction + MMIO helpers. */
+	IOReturn wacs2NoChk(uint32_t write, uint32_t addr, uint32_t wdata, uint32_t *rdata);
+	void athensPwrapInit(void);
+	inline uint32_t infraRd(uint32_t off) { return *(volatile uint32_t *)(fInfraRegs + off); }
+	inline void infraWr(uint32_t off, uint32_t v) { *(volatile uint32_t *)(fInfraRegs + off) = v; }
+	inline uint32_t topRd(uint32_t off) { return *(volatile uint32_t *)(fTopRegs + off); }
 
 	IOMemoryMap *fMap;
 	vm_offset_t  fRegs;
+	IOMemoryMap *fInfraMap, *fTopMap;
+	vm_offset_t  fInfraRegs, fTopRegs;
 	IOLock      *fLock;
 	uint32_t     fTimeouts;
 };
