--- a/bsd/sweet_hfs/core/hfs_btreeio.c
+++ b/bsd/sweet_hfs/core/hfs_btreeio.c
@@ -252,8 +252,20 @@
      * be writing node whose last record just got deleted.
      */
     retval = hfs_swap_BTNode (&block, vp, kSwapBTNodeHostToBig, true);
-    if (retval)
-    	panic("hfs: btree_swap_node: about to write corrupt node!\n");
+    if (retval) {
+    	/*
+    	 * Bring-up: a node that fails write-side validation is genuinely
+    	 * corrupt (bad kind/height/record offsets - bad fLink/bLink are now
+    	 * clamped in hfs_swap_BTNode).  Panicking here kills the kernel on a
+    	 * single bad catalog write driven by the userspace crash storm.
+    	 * Quarantine the node instead: zero the buffer so a structurally
+    	 * valid empty (free) node is written rather than garbage, and let the
+    	 * owning operation fail with EIO at a higher level.
+    	 */
+    	printf("hfs: btree_swap_node: quarantining corrupt node (blk %llu retval %d)\n",
+    	       (unsigned long long)block.blockNum, retval);
+    	memset(block.buffer, 0, block.blockSize);
+    }
