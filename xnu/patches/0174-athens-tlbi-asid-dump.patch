 				vm_page_assign_special_state(mem, VM_PAGE_SPECIAL_Q_BG);
 			}
 		}
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+		SWEET_CHECK_HANDOUT(mem);
+#endif
 		return mem;
 	}
 	enable_preemption();
@@ -3216,6 +3409,9 @@ restart:
