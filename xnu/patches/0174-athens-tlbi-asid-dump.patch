Stale-translation differential + CPU-id capture for the corruption hunt.

* osfmk/vm/vm_resident.c - sweet_tlbi_flush(): tlbi vmalle1is on every
  vm_page_grab_options handout and every zone page intake
  (sweettlbi=0 disables). If corruption stops under the flush, a stale
  or aliased mapping is the writer - narrow the flush afterward.
  Also print ID_AA64MMFR0_EL1 (ASIDBits), MIDR_EL1, TCR_EL1, SCTLR_EL1
  in the SWEET LAYOUT block so XNU's MAX_ASIDS assumption can be checked
  against real hardware.

diff --git a/osfmk/arm/pmap/pmap.c b/osfmk/arm/pmap/pmap.c
index 584ee38..bd5be94 100644
--- a/osfmk/arm/pmap/pmap.c
+++ b/osfmk/arm/pmap/pmap.c
@@ -2647,6 +2647,29 @@ pmap_next_page(
 		first_avail += PAGE_SIZE;
 		assert(avail_page_count > 0);
 		--avail_page_count;
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+		{
+			static pmap_paddr_t sweet_pool_next;
+			pmap_paddr_t pa = (pmap_paddr_t)ptoa(*pnum);
+
+			/* SWEET corruption hunt: the bootstrap pool carves
+			 * strictly upward from topOfKernelData. A PA below
+			 * it lands in the kernel/ADT/boot_args/ramdisk
+			 * carve; a gap in the sequence means first_avail
+			 * was reset and pages can be handed out twice. */
+			if (__improbable(pa < BootArgs->topOfKernelData ||
+			    pa + PAGE_SIZE > avail_end ||
+			    (sweet_pool_next && pa != sweet_pool_next))) {
+				panic("SWEET pmap_next_page: pa 0x%llx outside bootstrap pool "
+				    "(topOfKernelData 0x%llx avail_end 0x%llx expected 0x%llx)",
+				    (unsigned long long)pa,
+				    (unsigned long long)BootArgs->topOfKernelData,
+				    (unsigned long long)avail_end,
+				    (unsigned long long)sweet_pool_next);
+			}
+			sweet_pool_next = pa + PAGE_SIZE;
+		}
+#endif
 		return TRUE;
 	}
 	assert(avail_page_count == 0);
