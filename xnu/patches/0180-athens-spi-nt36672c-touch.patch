+static uint32_t
+dtU32(IOService *provider, const char *key, uint32_t dflt)
+{
+	OSData *d = OSDynamicCast(OSData, provider->getProperty(key));
+	return (d != NULL && d->getLength() >= 4) ? *(const uint32_t *)d->getBytesNoCopy() : dflt;
+}
+
+static void
+dtStr(IOService *provider, const char *key, char *buf, uint32_t buflen, const char *dflt)
+{
+	OSString *s = OSDynamicCast(OSString, provider->getProperty(key));
+	strlcpy(buf, s != NULL ? s->getCStringNoCopy() : dflt, buflen);
+}
+
+static uint32_t
+le32(const uint8_t *p)
+{
+	return p[0] | (p[1] << 8) | (p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+IOWorkLoop *
+AthensNT36672C::getWorkLoop(void) const
+{
+	return fWorkLoop;
+}
+
+/* nvt_set_page: 3-byte index write {0xFF, addr>>15, addr>>7}. */
+bool
+AthensNT36672C::setPage(uint32_t addr)
+{
+	uint8_t b[3] = { 0xFF, (uint8_t)(addr >> 15), (uint8_t)(addr >> 7) };
+	return fBus->transfer(b, NULL, 3) == kIOReturnSuccess;
+}
+
+/* CTP_SPI_WRITE: single CS frame, buf[0] gets SPI_WRITE_MASK (|0x80).
+ * Callers pre-fill buf[0] with the offset (addr & 0x7F at their map page). */
+bool
+AthensNT36672C::ctpWrite(uint8_t *buf, uint32_t len)
+{
+	buf[0] |= 0x80;
+	return fBus->transfer(buf, NULL, len) == kIOReturnSuccess;
+}
+
+/* CTP_SPI_READ: single CS frame of len+1 bytes ({buf0&0x7F, buf1.., dummy}
+ * out); the chip's data lands in buf[1..len-1] taken from rbuf[2..len]. */
+bool
+AthensNT36672C::ctpRead(uint8_t *buf, uint32_t len)
+{
+	uint8_t *tx = (uint8_t *)IOMalloc(len + NVT_DUMMY_BYTES);
+	uint8_t *rx = (uint8_t *)IOMalloc(len + NVT_DUMMY_BYTES);
+	if (tx == NULL || rx == NULL) {
+		if (tx) IOFree(tx, len + 1);
+		if (rx) IOFree(rx, len + 1);
+		return false;
+	}
+	memcpy(tx, buf, len);
+	tx[0] &= 0x7F;
+	tx[len] = 0;
+	bool ok = fBus->transfer(tx, rx, len + NVT_DUMMY_BYTES) == kIOReturnSuccess;
+	if (ok) {
+		memcpy(buf + 1, rx + 2, len - 1);
+	}
+	IOFree(tx, len + 1);
+	IOFree(rx, len + 1);
+	return ok;
+}
+
+/* nvt_write_addr: set_page + {addr&0x7F, data}. */
+bool
+AthensNT36672C::writeAddr(uint32_t addr, uint8_t data)
+{
+	if (!setPage(addr)) {
+		return false;
+	}
+	uint8_t b[2] = { (uint8_t)(addr & 0x7F), data };
+	return ctpWrite(b, 2);
+}
+
+bool
+AthensNT36672C::bootloaderReset(void)
+{
+	if (!writeAddr(fSwrst, 0x69)) {
+		return false;
+	}
+	IODelay(5000);                       /* tBRST2FR */
+	if (fRdfast) {
+		writeAddr(fRdfast, 0x00);        /* disable SPI_RD_FAST */
+	}
+	return true;
+}
+
+/* poll event-buf RESET_COMPLETE for buf[1] in [state, RESET_STATE_MAX]. */
+bool
+AthensNT36672C::checkResetState(uint8_t state)
+{
+	if (!setPage(fMap->event_buf | EV_RESET_COMPLETE)) {
+		return false;
+	}
+	uint8_t buf[6] = { EV_RESET_COMPLETE, 0, 0, 0, 0, 0 };
+	for (uint32_t i = 0; i <= 10; i++) { /* RESET_STATE_INIT: retry 10 */
+		buf[1] = 0;
+		if (ctpRead(buf, 6) && buf[1] >= state && buf[1] <= NVT_RST_MAX) {
+			return true;
+		}
+		IOSleep(10);
+	}
+	IOLog("ATHENS TOUCH: reset state timeout (last 0x%02x)\n", buf[1]);
+	return false;
+}
+
+/* nvt_boot_ready: BOOT_RDY=1; sw path also writes 0 + POR_CD 0xA0. */
+void
+AthensNT36672C::bootReady(void)
+{
+	writeAddr(fMap->boot_rdy, 1);
+	IODelay(5000);
+	if (!fMap->hw_crc) {
+		writeAddr(fMap->boot_rdy, 0);
+		writeAddr(fMap->por_cd, 0xA0);
+	}
+}
+
+/* nvt_ts_check_chip_ver_trim: bootloader-reset then read 6 ID bytes at
+ * xdata 0x1F64E and match the trim table. Needs a working SWRST addr, which
+ * is what we're trying to discover — try the 672-family default plus the
+ * legacy addresses before giving up. 5 retries per candidate like vendor. */
+bool
+AthensNT36672C::chipTrim(void)
+{
+	static const uint32_t swrst_try[] = { 0x03F0FE, 0x01F01A, 0x01C0BE };
+	for (uint32_t s = 0; s < sizeof(swrst_try) / sizeof(swrst_try[0]); s++) {
+		fSwrst = swrst_try[s];
+		for (int retry = 5; retry > 0; retry--) {
+			if (!bootloaderReset() || !setPage(NVT_TRIM_PAGE)) {
+				continue;
+			}
+			uint8_t buf[7] = { 0x4E, 0, 0, 0, 0, 0, 0 };
+			if (!ctpRead(buf, 7)) {
+				continue;
+			}
+			for (uint32_t t = 0; t < sizeof(TRIM) / sizeof(TRIM[0]); t++) {
+				uint32_t i;
+				for (i = 0; i < 6; i++) {
+					if (TRIM[t].mask[i] && buf[i + 1] != TRIM[t].id[i]) {
+						break;
+					}
+				}
+				if (i == 6) {
+					IOLog("ATHENS TOUCH: trim id %02x %02x %02x %02x %02x %02x -> %s map\n",
+					    buf[1], buf[2], buf[3], buf[4], buf[5], buf[6], TRIM[t].map->name);
+					static struct nvt_map chosen;
+					chosen = *TRIM[t].map;
+					chosen.swrst = fSwrst;      /* keep the reset addr that worked */
+					fMap = &chosen;
+					return true;
+				}
+			}
+			IOSleep(10);
+		}
+	}
+	return false;
+}
+
+/* nvt_get_fw_info on the selected map. */
+bool
+AthensNT36672C::fwInfo(void)
+{
+	for (int retry = 0; retry < 3; retry++) {
+		if (!setPage(fMap->event_buf | EV_FWINFO)) {
+			continue;
+		}
+		uint8_t buf[17] = { EV_FWINFO, 0 };
+		if (ctpRead(buf, 17) && (buf[1] + buf[2]) == 0xFF) {
+			fFwVer = buf[1];
+			uint32_t x = (buf[5] << 8) | buf[6], y = (buf[7] << 8) | buf[8];
+			if (x != 0 && y != 0) {
+				fMaxX = x;
+				fMaxY = y;
+			}
+			IOLog("ATHENS TOUCH: fw_ver 0x%02x fw_type 0x%02x %ux%u ch %ux%u\n",
+			    fFwVer, buf[14], fMaxX, fMaxY, buf[3], buf[4]);
+			return true;
+		}
+		IOSleep(10);
+	}
+	return false;
+}
+
+/* nvt_download_firmware[_hw_crc]: the complete download flow. */
+bool
+AthensNT36672C::fwDownload(const uint8_t *fw, uint32_t fwsize)
+{
+	/* ---- nvt_bin_header_parser (verified layout) ---- */
+	uint32_t end = le32(fw);
+	if (end < 0x30 || end > fwsize) {
+		IOLog("ATHENS TOUCH: bad fw header end 0x%x\n", end);
+		return false;
+	}
+	uint32_t info_sec = (end - 0x30) / 0x10;
+	uint32_t ovly_sec = (fw[0x28] & 0x10) ? (fw[0x28] & 0x0F) : 0;
+	uint32_t partition = 2 + ovly_sec + info_sec;
+	struct nvt_part part[24];
+	if (partition > sizeof(part) / sizeof(part[0])) {
+		return false;
+	}
+	memset(part, 0, sizeof(part));
+	uint8_t hwcrc = fMap->hw_crc;
+	for (uint32_t i = 0; i < partition; i++) {
+		uint32_t cpos;
+		if (i < 2) {                          /* ILM/DLM: 12B {BIN,SRAM,size} */
+			part[i].bin = le32(fw + i * 12);
+			part[i].sram = le32(fw + 4 + i * 12);
+			part[i].size = le32(fw + 8 + i * 12);
+			cpos = 0x18 + i * 4;
+		} else if (i < 2 + info_sec) {        /* info: 16B @0x30 {SRAM,size,BIN,crc} */
+			uint32_t pos = 0x30 + 0x10 * (i - 2);
+			part[i].sram = le32(fw + pos);
+			part[i].size = le32(fw + pos + 4);
+			part[i].bin = le32(fw + pos + 8);
+			cpos = pos + 12;
+		} else {                              /* ovly: 16B @ DLM.BIN + 0x10*i' */
+			uint32_t pos = part[1].bin + 0x10 * (i - 2 - info_sec);
+			if (pos + 16 > fwsize) {
+				continue;
+			}
+			part[i].sram = le32(fw + pos);
+			part[i].size = le32(fw + pos + 4);
+			part[i].bin = le32(fw + pos + 8);
+			cpos = pos + 12;
+		}
+		if (hwcrc) {
+			part[i].crc = le32(fw + cpos);
+		} else if (part[i].size != 0 && part[i].bin + part[i].size <= fwsize) {
+			uint32_t c = 0;                   /* CheckSum(): ~(sum(data[0..size]) + size) + 1 */
+			for (uint32_t j = 0; j <= part[i].size; j++) {
+				c += fw[part[i].bin + j];
+			}
+			part[i].crc = ~(c + part[i].size) + 1;
+		}
+		if (part[i].size != 0 && part[i].bin + part[i].size > fwsize) {
+			IOLog("ATHENS TOUCH: part %u out of range\n", i);
+			return false;
+		}
+	}
+	IOLog("ATHENS TOUCH: %u parts (info %u, ovly %u) on %s map\n",
+	    partition, info_sec, ovly_sec, fMap->name);
+
+	for (int retry = 0; retry < 3; retry++) {
+		bool bad = false;
+		if (!hwcrc) {                         /* nvt_eng_reset first (sw path) */
+			writeAddr(NVT_ENG_RST, 0x5A);
+			IODelay(1000);
+		}
+		if (!bootloaderReset()) {
+			continue;
+		}
+		if (!hwcrc) {                         /* clear fw reset status */
+			writeAddr(fMap->event_buf | EV_RESET_COMPLETE, 0x00);
+		}
+		/* nvt_write_firmware: skip size==0, else size+1, <=63KiB bursts */
+		for (uint32_t p = 0; p < partition && !bad; p++) {
+			if (part[p].size == 0) {
+				continue;
+			}
+			uint32_t size = part[p].size + 1;
+			for (uint32_t off = 0; off < size; ) {
+				uint32_t n = (size - off) < NVT_TRANSFER_LEN ? (size - off) : NVT_TRANSFER_LEN;
+				uint32_t a = part[p].sram + off;
+				if (!setPage(a)) { bad = true; break; }
+				uint8_t *frame = (uint8_t *)IOMalloc(n + 1);
+				if (frame == NULL) { bad = true; break; }
+				frame[0] = (uint8_t)((a & 0x7F) | 0x80);
+				memcpy(frame + 1, fw + part[p].bin + off, n);
+				if (fBus->transfer(frame, NULL, n + 1) != kIOReturnSuccess) {
+					IOFree(frame, n + 1);
+					bad = true;
+					break;
+				}
+				IOFree(frame, n + 1);
+				off += n;
+			}
+		}
+		if (bad) {
+			continue;
+		}
+		if (hwcrc) {
+			/* nvt_set_bld_hw_crc: ILM/DLM reg banks (same 0x3F1x page) */
+			for (uint32_t p = 0; p < 2; p++) {
+				uint32_t des = p ? fMap->dlm_des : fMap->ilm_des;
+				uint32_t len = p ? fMap->dlm_len : fMap->ilm_len;
+				uint32_t cks = p ? fMap->g_dlm : fMap->g_ilm;
+				uint8_t w[5];
+				if (!setPage(des)) { bad = true; break; }
+				w[0] = (uint8_t)(des & 0x7F);
+				w[1] = part[p].sram & 0xFF;
+				w[2] = (part[p].sram >> 8) & 0xFF;
+				w[3] = (part[p].sram >> 16) & 0xFF;
+				if (!ctpWrite(w, 4)) { bad = true; break; }
+				w[0] = (uint8_t)(len & 0x7F);
+				w[1] = part[p].size & 0xFF;
+				w[2] = (part[p].size >> 8) & 0xFF;
+				if (!ctpWrite(w, 3)) { bad = true; break; }  /* hw_crc==1: 2B len */
+				if (!setPage(cks)) { bad = true; break; }
+				w[0] = (uint8_t)(cks & 0x7F);
+				w[1] = part[p].crc & 0xFF;
+				w[2] = (part[p].crc >> 8) & 0xFF;
+				w[3] = (part[p].crc >> 16) & 0xFF;
+				w[4] = (part[p].crc >> 24) & 0xFF;
+				if (!ctpWrite(w, 5)) { bad = true; break; }
+			}
+			if (bad) {
+				continue;
+			}
+			/* nvt_bld_crc_enable: BLD_CRC_EN_ADDR |= 0x80 */
+			if (!setPage(fMap->bld_crc_en)) {
+				continue;
+			}
+			uint8_t b[2] = { (uint8_t)(fMap->bld_crc_en & 0x7F), 0xFF };
+			if (!ctpRead(b, 2)) {
+				continue;
+			}
+			b[0] = (uint8_t)(fMap->bld_crc_en & 0x7F);
+			b[1] |= 0x80;
+			if (!ctpWrite(b, 2)) {
+				continue;
+			}
+			/* nvt_fw_crc_enable: RESET_COMPLETE=0, HOST_CMD=0xAE */
+			if (!setPage(fMap->event_buf)) {
+				continue;
+			}
+			uint8_t w[2] = { EV_RESET_COMPLETE & 0x7F, 0x00 };
+			if (!ctpWrite(w, 2)) {
+				continue;
+			}
+			w[0] = EV_HOST_CMD & 0x7F; w[1] = 0xAE;
+			if (!ctpWrite(w, 2)) {
+				continue;
+			}
+		}
+		bootReady();
+		if (!checkResetState(NVT_RST_INIT)) {
+			continue;
+		}
+		if (!hwcrc) {
+			/* nvt_check_fw_checksum: read partition*4 @R_ILM, cmp LE32 */
+			uint32_t len = partition * 4;
+			uint8_t *sum = (uint8_t *)IOMalloc(len + 1);
+			if (sum == NULL) {
+				return false;
+			}
+			sum[0] = (uint8_t)(fMap->r_ilm & 0x7F);
+			bool rd = setPage(fMap->r_ilm) && ctpRead(sum, len + 1);
+			uint32_t badcrc = 0;
+			if (rd) {
+				for (uint32_t p = 0; p < partition; p++) {
+					if (part[p].size && part[p].crc != le32(sum + 1 + p * 4)) {
+						badcrc++;
+					}
+				}
+			}
+			IOFree(sum, len + 1);
+			if (!rd || badcrc) {
+				IOLog("ATHENS TOUCH: fw checksum failed\n");
+				continue;
+			}
+		}
+		IOLog("ATHENS TOUCH: firmware download ok (%s map)\n", fMap->name);
+		return fwInfo();
+	}
+	IOLog("ATHENS TOUCH: firmware download failed after retries\n");
+	return false;
+}
+
+/* Boot_Update_Firmware: open the blob and stream it. */
+bool
+AthensNT36672C::fwUpdate(void)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	uint8_t *fw = NULL;
+	bool ok = false;
+	if (vnode_open(fFwPath, FREAD, 0, 0, &vp, ctx) != 0) {
+		/* No rootfs file (image predates the firmware install): fall back
+		 * to the blob compiled into the kernel. */
+		IOLog("ATHENS TOUCH: %s not found, using built-in firmware\n", fFwPath);
+		return fwDownload(kNt36672cFw, kNt36672cFwLen);
+	}
+	off_t size = 0;
+	vnode_size(vp, &size, ctx);
+	if (size >= 0x100 && size <= (256 * 1024)) {
+		fw = (uint8_t *)IOMalloc((uint32_t)size);
+	}
+	if (fw != NULL) {
+		int resid = 0;
+		if (vn_rdwr(UIO_READ, vp, (caddr_t)fw, (int)size, 0, UIO_SYSSPACE,
+		    IO_NOAUTH | IO_UNIT, vfs_context_ucred(ctx), &resid,
+		    vfs_context_proc(ctx)) == 0 && resid == 0) {
+			IOLog("ATHENS TOUCH: downloading %lld-byte firmware %s\n",
+			    (long long)size, fFwPath);
+			ok = fwDownload(fw, (uint32_t)size);
+		}
+		IOFree(fw, (uint32_t)size);
+	}
+	vnode_close(vp, FREAD, ctx);
+	return ok;
+}
+
+bool
+AthensNT36672C::init(OSDictionary *props)
+{
+	if (!SweetHIDTouch::init(props)) {
+		return false;
+	}
+	/* Zero everything free() may touch: a failed match frees the
+	 * instance without start() ever assigning these. */
+	fPrevMap = 0;
+	fWdtCnt = 0;
+	fFwDone = false;
+	fFwVer = 0;
+	fBus = NULL;
+	fGPIO = NULL;
+	fWorkLoop = NULL;
+	fInterrupt = NULL;
+	fFwTimer = NULL;
+	fMap = NULL;
+	fFwPath[0] = '\0';
+	return true;
+}
+
+bool
+AthensNT36672C::start(IOService *provider)
+{
+	fPrevMap = 0;
+	fWdtCnt = 0;
+	fFwDone = false;
+	fFwVer = 0;
+	fInterrupt = NULL;
+	fFwTimer = NULL;
+	fBus = OSDynamicCast(AthensSPI, provider->getProvider());
+	fGPIO = VivaGPIO::wait();
+	fWorkLoop = IOWorkLoop::workLoop();
+	fReset = dtU32(provider, "reset-gpio", 33);
+	fMaxX = dtU32(provider, "max-x", 1080);
+	fMaxY = dtU32(provider, "max-y", 2400);
+	fSwrst = dtU32(provider, "swrst-addr", NVT_SWRST_DFLT);
+	fRdfast = dtU32(provider, "rd-fast-addr", NVT_RDFAST_DFLT);
+	dtStr(provider, "fw-path", fFwPath, sizeof(fFwPath),
+	    "/usr/share/firmware/touch/nt36672c_jdi.bin");
+	if (fBus == NULL || fGPIO == NULL || fWorkLoop == NULL) {
+		IOLog("ATHENS TOUCH: missing SPI bus, GPIO or work loop\n");
+		return false;
+	}
+	fMap = &MAP_A;
+	fGPIO->setOutput(fReset, true);          /* reset line: live pinctrl holds it high */
+	IOSleep(5);
+
+	/* Identify the map family via the trim ID table (tries the candidate
+	 * SWRST addresses). Without a match we keep the last candidate and let
+	 * fwInfo/download decide — the chip answers or it doesn't. */
+	if (!chipTrim()) {
+		IOLog("ATHENS TOUCH: trim id not recognised, keeping %s map\n", fMap->name);
+	}
+	/* A running fw answers fwInfo; a blank NF chip needs the blob. */
+	if (!fwInfo()) {
+		IOLog("ATHENS TOUCH: no running fw on %s map, will download %s\n",
+		    fMap->name, fFwPath);
+		fFwTimer = IOTimerEventSource::timerEventSource(this, &AthensNT36672C::fwTimeout);
+		if (fFwTimer == NULL || fWorkLoop->addEventSource(fFwTimer) != kIOReturnSuccess) {
+			IOLog("ATHENS TOUCH: no fw timer\n");
+			return false;
+		}
+		fFwTimer->setTimeoutMS(1000);
+	}
+
+	if (!SweetHIDTouch::start(provider)) {
+		return false;
+	}
+	fInterrupt = IOInterruptEventSource::interruptEventSource(this,
+	    &AthensNT36672C::interruptOccurred, provider, 0);
+	if (fInterrupt == NULL || fWorkLoop->addEventSource(fInterrupt) != kIOReturnSuccess) {
+		IOLog("ATHENS TOUCH: no interrupt\n");
+		return false;
+	}
+	fInterrupt->enable();
+	IOLog("ATHENS TOUCH: NT36672C on %s map, %ux%u%s\n", fMap->name,
+	    fMaxX, fMaxY, fFwDone ? "" : " (fw pending)");
+	return true;
+}
+
+void
+AthensNT36672C::free(void)
+{
+	if (fInterrupt != NULL) {
+		fInterrupt->disable();
+		if (fWorkLoop != NULL) fWorkLoop->removeEventSource(fInterrupt);
+	}
+	if (fFwTimer != NULL) {
+		fFwTimer->cancelTimeout();
+		if (fWorkLoop != NULL) fWorkLoop->removeEventSource(fFwTimer);
+	}
+	OSSafeReleaseNULL(fInterrupt);
+	OSSafeReleaseNULL(fFwTimer);
+	SweetHIDTouch::free();
+	OSSafeReleaseNULL(fWorkLoop);
+}
+
+void
+AthensNT36672C::fwTimeout(OSObject *owner, IOTimerEventSource *src __unused)
+{
+	AthensNT36672C *self = OSDynamicCast(AthensNT36672C, owner);
+	if (self == NULL || self->fFwDone) {
+		return;
+	}
+	if (self->fwUpdate()) {
+		self->fFwDone = true;
+		IOLog("ATHENS TOUCH: firmware running (fw_ver 0x%02x)\n", self->fFwVer);
+	} else {
+		self->fFwTimer->setTimeoutMS(1000);
+	}
+}
+
+void
+AthensNT36672C::interruptOccurred(OSObject *owner, IOInterruptEventSource *src __unused, int count __unused)
+{
+	AthensNT36672C *self = OSDynamicCast(AthensNT36672C, owner);
+	if (self != NULL) {
+		self->handleEvent();
+	}
+}
+
+/* nvt_ts_work_func: recovery checks, packet checksum, then the 65-byte
+ * report (10 x 6-byte slots at pos 1+6i, buttons at 61-62, checksum at 65). */
+void
+AthensNT36672C::handleEvent(void)
+{
+	uint8_t pd[NVT_POINT_LEN + 1] = { 0 };   /* pd[0] = xdata index 0 */
+	if (!setPage(fMap->event_buf) || !ctpRead(pd, NVT_POINT_LEN + 1)) {
+		return;
+	}
+	/* fw_recovery: all of pd[1..6]==0x77 -> chip rebooted, re-download */
+	uint32_t i;
+	for (i = 1; i < 7; i++) {
+		if (pd[i] != 0x77) break;
+	}
+	if (i == 7) {
+		IOLog("ATHENS TOUCH: fw reset (0x77), re-downloading\n");
+		fFwDone = false;
+		if (fFwTimer != NULL) fFwTimer->setTimeoutMS(1);
+		return;
+	}
+	/* wdt recovery: >10 consecutive reads all-{0xFD,0xFE} */
+	for (i = 1; i < 7; i++) {
+		if (pd[i] != 0xFD && pd[i] != 0xFE) break;
+	}
+	fWdtCnt = (i == 7) ? fWdtCnt + 1 : 0;
+	if (fWdtCnt > 10) {
+		IOLog("ATHENS TOUCH: wdt fw recovery\n");
+		fWdtCnt = 0;
+		fFwDone = false;
+		if (fFwTimer != NULL) fFwTimer->setTimeoutMS(1);
+		return;
+	}
+	/* packet checksum: pd[65] == ~(sum pd[1..64]) + 1 */
+	uint8_t sum = 0;
+	for (i = 1; i < NVT_POINT_LEN; i++) {
+		sum += pd[i];
+	}
+	if ((uint8_t)(~sum + 1) != pd[NVT_POINT_LEN]) {
+		return;                             /* corrupt packet, drop */
+	}
+	uint32_t map = 0;
+	for (i = 0; i < NVT_MAX_FINGERS; i++) {
+		uint32_t pos = 1 + 6 * i;
+		uint8_t id = pd[pos] >> 3;
+		uint8_t st = pd[pos] & 7;
+		if (id == 0 || id > NVT_MAX_FINGERS) {
+			continue;
+		}
+		if (st == 1 || st == 2) {           /* down | moving */
+			uint32_t x = (pd[pos + 1] << 4) | (pd[pos + 3] >> 4);
+			uint32_t y = (pd[pos + 2] << 4) | (pd[pos + 3] & 0x0F);
+			uint32_t slot = id - 1;
+			if (slot >= SWEET_TOUCH_FINGERS || x > fMaxX || y > fMaxY) {
+				continue;
+			}
+			map |= 1u << slot;
+			touch((int)slot, true, (int)x, (int)y);
+		}
+	}
+	for (uint32_t slot = 0; slot < SWEET_TOUCH_FINGERS; slot++) {
+		if ((fPrevMap & (1u << slot)) && !(map & (1u << slot))) {
+			touch((int)slot, false, 0, 0);
+		}
+	}
+	fPrevMap = map;
+}
