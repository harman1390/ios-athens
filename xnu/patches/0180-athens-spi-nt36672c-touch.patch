diff --git a/iokit/Kernel/arm/AthensSPI.cpp b/iokit/Kernel/arm/AthensSPI.cpp
new file mode 100644
index 0000000..a59c0e7
--- /dev/null
+++ b/iokit/Kernel/arm/AthensSPI.cpp
@@ -0,0 +1,295 @@
+/*
+ * athens (MT6853): MediaTek SPI host driver (see AthensSPI.h).
+ *
+ * Register map and protocol from Xiaomi's spi-mt65xx.c (mt6765 compat):
+ *   CFG0 0x00  [sck_high:0-7 sck_low:8-15 cs_hold:16-23 cs_setup:24-31]
+ *   CFG1 0x04  [cs_idle:0-7 packet_loop:8-15 packet_len:16-25]
+ *   TX_SRC 0x08 / RX_DST 0x0c (DMA phys addrs), TX_DATA 0x10 / RX_DATA 0x14
+ *   CMD 0x18   ACT=b0 RESUME=b1 RST=b2 PAUSE_EN=b4 DEASSERT=b5 SAMPLE_SEL=b6
+ *              CS_POL=b7 CPHA=b8 CPOL=b9 RX_DMA=b10 TX_DMA=b11 TXMSBF=b12
+ *              RXMSBF=b13 RX_ENDIAN=b14 TX_ENDIAN=b15 FINISH_IE=b16 PAUSE_IE=b17
+ *   STATUS0 0x1c (busy=b0)  STATUS1 0x20  PAD_SEL 0x24  CFG2 0x28
+ * FIFO 32 B, DMA packet <= 1024 B, packet_loop <= 255.
+ *
+ * Bus setup (live FDT / clk-mt6853.c): spi_sel mux -> msdcpll_d4 ~96 MHz
+ * (topckgen CLK_CFG_6+0x70 lsb16 w2, update reg +0x04 bit26), bus gate
+ * ifrao_spi4 (infracfg_ao +0xa4 set bit25). SPI4 pins SCK=12 MISO=13
+ * MOSI=97 CS=98 all func2 - the bootloader/pinctrl already muxes them
+ * (verified working in recovery); chip conf mode 0 MSB, sck high=low=5
+ * (~9.6 MHz of the ~96 MHz source, matching the 9.6 MHz DT max).
+ */
+#include <IOKit/IOLib.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <libkern/OSByteOrder.h>
+#include "AthensSPI.h"
+
+#define SPI_CFG0        0x00
+#define SPI_CFG1        0x04
+#define SPI_TX_SRC      0x08
+#define SPI_RX_DST      0x0c
+#define SPI_TX_DATA     0x10
+#define SPI_RX_DATA     0x14
+#define SPI_CMD         0x18
+#define SPI_STATUS0     0x1c
+#define SPI_STATUS1     0x20
+#define SPI_PAD_SEL     0x24
+#define SPI_CFG2        0x28
+
+#define SPI_CMD_ACT         (1u << 0)
+#define SPI_CMD_RESUME      (1u << 1)
+#define SPI_CMD_RST         (1u << 2)
+#define SPI_CMD_PAUSE_EN    (1u << 4)
+#define SPI_CMD_DEASSERT    (1u << 5)
+#define SPI_CMD_SAMPLE_SEL  (1u << 6)
+#define SPI_CMD_CS_POL      (1u << 7)
+#define SPI_CMD_CPHA        (1u << 8)
+#define SPI_CMD_CPOL        (1u << 9)
+#define SPI_CMD_RX_DMA      (1u << 10)
+#define SPI_CMD_TX_DMA      (1u << 11)
+#define SPI_CMD_TXMSBF      (1u << 12)
+#define SPI_CMD_RXMSBF      (1u << 13)
+#define SPI_CMD_FINISH_IE   (1u << 16)
+
+#define SPI_STATUS0_BUSY    (1u << 0)
+#define SPI_PACKET_SIZE     1024u
+
+/* topckgen CLK_CFG_6 spi_sel mux (reg1): lsb 16, width 2, value 3 = msdcpll_d4 */
+#define CLK_CFG6            0x070
+#define CLK_CFG6_SET        0x074
+#define CLK_CFG6_CLR        0x078
+#define CLK_CFG_UPDATE      0x004
+#define SPI_SEL_LSB         16
+#define SPI_SEL_VAL         3u
+#define TOP_MUX_SPI_SHIFT   26
+/* infracfg_ao ifrao_spi4 gate (reg2): set ofs 0xa4, bit 25 */
+#define IFRAO4_CG_SET       0x0a4
+#define IFRAO_SPI4_BIT      25
+
+OSDefineMetaClassAndStructors(AthensSPI, IOService);
+
+static AthensSPI *gSPI;
+
+AthensSPI *
+AthensSPI::wait(void)
+{
+	for (int i = 0; i < 200 && gSPI == NULL; i++) {
+		IOSleep(10);
+	}
+	return gSPI;
+}
+
+IOWorkLoop *
+AthensSPI::getWorkLoop(void) const
+{
+	return fWorkLoop;
+}
+
+void
+AthensSPI::initHW(void)
+{
+	/* soft reset, then static config: mode 0 MSB, ~9.6 MHz, cs_idle 2,
+	 * finish intr (we poll STATUS0 busy instead), no pause/deassert. */
+	wr32(SPI_CMD, rd32(SPI_CMD) | SPI_CMD_RST);
+	IODelay(10);
+	wr32(SPI_CMD, rd32(SPI_CMD) & ~SPI_CMD_RST);
+	wr32(SPI_CFG0, (5 << 0) | (5 << 8) | (0 << 16) | (0 << 24));
+	wr32(SPI_CFG1, (2 - 1) << 0);        /* cs_idletime 2 -> field value 1 */
+	wr32(SPI_PAD_SEL, 0);
+	wr32(SPI_CMD, SPI_CMD_TXMSBF | SPI_CMD_RXMSBF | SPI_CMD_FINISH_IE);
+}
+
+bool
+AthensSPI::waitBusy(uint32_t timeoutUs)
+{
+	while (rd32(SPI_STATUS0) & SPI_STATUS0_BUSY) {
+		if (timeoutUs == 0) {
+			return false;
+		}
+		IODelay(5);
+		timeoutUs--;
+	}
+	return true;
+}
+
+bool
+AthensSPI::init(OSDictionary *props)
+{
+	if (!IOService::init(props)) {
+		return false;
+	}
+	/* Zero everything free() may touch: start() bails before assigning
+	 * fGate/fRegs, and a failed match still frees the instance. */
+	fMap = fTopMap = fInfraMap = NULL;
+	fRegs = fTopRegs = fInfraRegs = 0;
+	fWorkLoop = NULL;
+	fGate = NULL;
+	fDMA = NULL;
+	fDMAPhys = 0;
+	fErrors = 0;
+	return true;
+}
+
+bool
+AthensSPI::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	fMap = provider->mapDeviceMemoryWithIndex(0);
+	fTopMap = provider->mapDeviceMemoryWithIndex(1);
+	fInfraMap = provider->mapDeviceMemoryWithIndex(2);
+	fWorkLoop = IOWorkLoop::workLoop();
+	fDMA = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
+	    kIODirectionInOut | kIOMemoryPhysicallyContiguous, kDMASize,
+	    (mach_vm_address_t)0x00000000FFFFF000ULL);
+	if (fMap == NULL || fWorkLoop == NULL || fDMA == NULL) {
+		IOLog("ATHENS SPI: missing resource map=%p loop=%p dma=%p\n",
+		    fMap, fWorkLoop, fDMA);
+		return false;
+	}
+	fRegs = fMap->getVirtualAddress();
+	fTopRegs = fTopMap != NULL ? fTopMap->getVirtualAddress() : 0;
+	fInfraRegs = fInfraMap != NULL ? fInfraMap->getVirtualAddress() : 0;
+	fDMAPhys = (uint32_t)fDMA->getPhysicalSegment(0, NULL, kIOMemoryMapperNone);
+	fGate = IOCommandGate::commandGate(this);
+	if (fGate == NULL || fWorkLoop->addEventSource(fGate) != kIOReturnSuccess) {
+		IOLog("ATHENS SPI: no gate\n");
+		return false;
+	}
+
+	/* spi_sel mux -> msdcpll_d4 (~96 MHz) and the bus gate ifrao_spi4.
+	 * Both are one-off: if the bases aren't in the ADT the block keeps
+	 * whatever the bootloader left (recovery shows the defaults work). */
+	if (fTopRegs != 0) {
+		volatile uint32_t *top = (volatile uint32_t *)fTopRegs;
+		top[CLK_CFG6_CLR / 4] = SPI_SEL_VAL << SPI_SEL_LSB;
+		top[CLK_CFG6_SET / 4] = SPI_SEL_VAL << SPI_SEL_LSB;
+		top[CLK_CFG_UPDATE / 4] = 1u << TOP_MUX_SPI_SHIFT;
+	}
+	if (fInfraRegs != 0) {
+		*(volatile uint32_t *)(fInfraRegs + IFRAO4_CG_SET) = 1u << IFRAO_SPI4_BIT;
+	}
+	initHW();
+	IOLog("ATHENS SPI: %s ready (cfg0 %08x cfg1 %08x cmd %08x)\n",
+	    provider->getName(), rd32(SPI_CFG0), rd32(SPI_CFG1), rd32(SPI_CMD));
+	registerService();
+	gSPI = this;
+	VivaDTNub::publishChildren(this, provider);
+	return true;
+}
+
+void
+AthensSPI::free(void)
+{
+	if (gSPI == this) {
+		gSPI = NULL;
+	}
+	if (fWorkLoop != NULL && fGate != NULL) {
+		fWorkLoop->removeEventSource(fGate);
+	}
+	OSSafeReleaseNULL(fGate);
+	OSSafeReleaseNULL(fDMA);
+	OSSafeReleaseNULL(fMap);
+	OSSafeReleaseNULL(fTopMap);
+	OSSafeReleaseNULL(fInfraMap);
+	OSSafeReleaseNULL(fWorkLoop);
+	IOService::free();
+}
+
+IOReturn
+AthensSPI::transfer(const uint8_t *txbuf, uint8_t *rxbuf, uint32_t len)
+{
+	if (len == 0 || len > kDMASize || (txbuf == NULL && rxbuf == NULL)) {
+		return kIOReturnBadArgument;
+	}
+	return fGate->runActionBlock(^IOReturn {
+		return transferGated(txbuf, rxbuf, len);
+	});
+}
+
+/*
+ * spi-mt65xx.c mtk_spi_transfer_one: one CS frame. <=32 B FIFO PIO; larger
+ * frames go through the controller's own DMA regs (TX_SRC/RX_DST +
+ * TX_DMA/RX_DMA), not the AP-DMA engine.
+ */
+IOReturn
+AthensSPI::transferGated(const uint8_t *txbuf, uint8_t *rxbuf, uint32_t len)
+{
+	uint32_t packet = 0, loop = 0, cfg1 = 0;
+	uint32_t cmd = rd32(SPI_CMD) & ~(SPI_CMD_TX_DMA | SPI_CMD_RX_DMA |
+	    SPI_CMD_PAUSE_EN | SPI_CMD_DEASSERT);
+
+	if (len <= kFIFOSize) {
+		/* PIO: packet_len = len, one packet; shift the frame through the
+		 * 32-byte FIFO, then drain the same number of RX bytes. */
+		uint32_t cfg1 = rd32(SPI_CFG1);
+		cfg1 &= ~((0x3ff << 16) | (0xff << 8));
+		cfg1 |= (len - 1) << 16;         /* packet_len = len, loop = 1 */
+		wr32(SPI_CFG1, cfg1);
+		if (txbuf != NULL) {
+			for (uint32_t i = 0; i < len; i += 4) {
+				uint32_t w = 0;
+				uint32_t n = (len - i) < 4 ? (len - i) : 4;
+				memcpy(&w, txbuf + i, n);
+				wr32(SPI_TX_DATA, w);
+			}
+		} else {
+			for (uint32_t i = 0; i < len; i += 4) {
+				wr32(SPI_TX_DATA, 0);
+			}
+		}
+		wr32(SPI_CMD, cmd | SPI_CMD_ACT);
+		if (!waitBusy(20000)) {
+			goto timeout;
+		}
+		if (rxbuf != NULL) {
+			for (uint32_t i = 0; i < len; i += 4) {
+				uint32_t w = rd32(SPI_RX_DATA);
+				uint32_t n = (len - i) < 4 ? (len - i) : 4;
+				memcpy(rxbuf + i, &w, n);
+			}
+		}
+		return kIOReturnSuccess;
+	}
+
+	/* DMA path: copy the frame into the contiguous buffer, program
+	 * packet_len (<=1024) + packet_loop, set the DMA cmd bits, ACT. */
+	if (txbuf != NULL) {
+		memcpy(fDMA->getBytesNoCopy(), txbuf, len);
+	} else {
+		memset(fDMA->getBytesNoCopy(), 0, len);
+	}
+	/* Clean+invalidate before the controller reads it (same op VivaWiFi
+	 * uses for both directions: this fork has no IOFlushCacheRange). */
+	fDMA->performOperation(kIOMemoryIncoherentIOFlush, 0, len);
+
+	packet = len < SPI_PACKET_SIZE ? len : SPI_PACKET_SIZE;
+	loop = (len + packet - 1) / packet;
+	cfg1 = rd32(SPI_CFG1);
+	cfg1 &= ~((0x3ff << 16) | (0xff << 8));
+	cfg1 |= (packet - 1) << 16 | (loop - 1) << 8;
+	wr32(SPI_CFG1, cfg1);
+	wr32(SPI_TX_SRC, fDMAPhys);
+	wr32(SPI_RX_DST, fDMAPhys);
+	cmd |= (txbuf != NULL ? SPI_CMD_TX_DMA : 0) | (rxbuf != NULL ? SPI_CMD_RX_DMA : 0);
+	wr32(SPI_CMD, cmd | SPI_CMD_ACT);
+	if (!waitBusy(100000)) {
+		goto timeout;
+	}
+	if (rxbuf != NULL) {
+		fDMA->performOperation(kIOMemoryIncoherentIOFlush, 0, len);
+		memcpy(rxbuf, fDMA->getBytesNoCopy(), len);
+	}
+	return kIOReturnSuccess;
+
+timeout:
+	fErrors++;
+	if (fErrors <= 8) {
+		IOLog("ATHENS SPI: transfer %u B timeout (status0 %08x status1 %08x)\n",
+		    len, rd32(SPI_STATUS0), rd32(SPI_STATUS1));
+	}
+	wr32(SPI_CMD, rd32(SPI_CMD) | SPI_CMD_RST);
+	IODelay(10);
+	wr32(SPI_CMD, rd32(SPI_CMD) & ~SPI_CMD_RST);
+	return kIOReturnTimeout;
+}
diff --git a/iokit/Kernel/arm/AthensSPI.h b/iokit/Kernel/arm/AthensSPI.h
new file mode 100644
index 0000000..83a2b91
--- /dev/null
+++ b/iokit/Kernel/arm/AthensSPI.h
@@ -0,0 +1,55 @@
+/*
+ * athens (MT6853): MediaTek SPI host driver (spi-mt65xx.c equivalent).
+ *
+ * AthensSPI (/arm-io/spi4, "mediatek,mt6765-spi"): mt65xx SPI controller in
+ * FIFO (<= 32 B) and internal-DMA (TX_SRC/RX_DST, one CS frame up to 255 KiB)
+ * modes, polled completion; publishes device-tree children as VivaDTNub nubs
+ * (child "reg" = chip select). reg 0 = the SPI block, optional reg 1 =
+ * topckgen (clock mux + gate setup described by "clock-mux"/"clock-gates").
+ */
+#ifndef _IOKIT_ARM_ATHENSSPI_H
+#define _IOKIT_ARM_ATHENSSPI_H
+
+#include <IOKit/IOService.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <IOKit/IOWorkLoop.h>
+#include <IOKit/IOCommandGate.h>
+
+#include "VivaPMIC.h"   /* VivaDTNub */
+
+class AthensSPI : public IOService {
+	OSDeclareDefaultStructors(AthensSPI);
+public:
+	enum { kFIFOSize = 32 };
+	enum { kDMASize  = 64 * 1024 };
+
+	virtual bool init(OSDictionary *props = NULL) APPLE_KEXT_OVERRIDE;
+	virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	virtual void free(void) APPLE_KEXT_OVERRIDE;
+	virtual IOWorkLoop *getWorkLoop(void) const APPLE_KEXT_OVERRIDE;
+
+	/*
+	 * One CS frame: full-duplex `len` bytes (tx may be NULL for a pure read,
+	 * rx may be NULL for a pure write). Sleeps: not from interrupt context.
+	 */
+	IOReturn transfer(const uint8_t *txbuf, uint8_t *rxbuf, uint32_t len);
+	/* The started controller, waiting for it if needed (NULL after timeout). */
+	static AthensSPI *wait(void);
+
+private:
+	IOReturn transferGated(const uint8_t *txbuf, uint8_t *rxbuf, uint32_t len);
+	void initHW(void);
+	bool waitBusy(uint32_t timeoutUs);
+	inline uint32_t rd32(uint32_t off) { return *(volatile uint32_t *)(fRegs + off); }
+	inline void wr32(uint32_t off, uint32_t v) { *(volatile uint32_t *)(fRegs + off) = v; }
+
+	IOMemoryMap             *fMap, *fTopMap, *fInfraMap;
+	vm_offset_t              fRegs, fTopRegs, fInfraRegs;
+	IOWorkLoop              *fWorkLoop;
+	IOCommandGate           *fGate;
+	IOBufferMemoryDescriptor *fDMA;
+	uint32_t                 fDMAPhys;
+	uint32_t                 fErrors;
+};
+
+#endif /* _IOKIT_ARM_ATHENSSPI_H */
diff --git a/iokit/Kernel/arm/hid/AthensNT36672C.cpp b/iokit/Kernel/arm/hid/AthensNT36672C.cpp
new file mode 100644
index 0000000..7ed29f2
--- /dev/null
+++ b/iokit/Kernel/arm/hid/AthensNT36672C.cpp
@@ -0,0 +1,764 @@
+/*
+ * athens (MT6853): Novatek NT36672C "noflash" touch controller, the built-in
+ * touch screen. Matches /arm-io/spi4/touch ("novatek,nt36672c"), a child of
+ * AthensSPI (../AthensSPI.cpp); it is a SweetHIDTouch, so contacts reach
+ * backboardd as the same digitizer collection events as on sweet.
+ *
+ * Protocol from the kernel's nt36xxx* sources (realme-mt6853 tree
+ * drivers/input/touchscreen/NT36672C/). The live binding is
+ * "oppo,tp_noflash"/"novatek,nf_nt36672c" — that exact driver lives in a
+ * vendor module not in the public tree, but the wire protocol below is the
+ * chip's (Novatek xdata paging + 65-byte event report), which the generic
+ * source documents verbatim:
+ *
+ *  - SPI frame: write = {addr|0x80, data...}; read = {addr&0x7F, ...tx,
+ *    dummy} in one CS frame; data lands at rbuf[2]. set_page =
+ *    {0xFF, addr>>15, addr>>7}. nvt_write_addr(a,d) = set_page(a) + write
+ *    {a&0x7F, d}.
+ *  - Trim: bootloader_reset (SWRST 0x69, fast-read off) -> page 0x1F64E,
+ *    read 7 -> 6 ID bytes matched against trim_id_table -> mmap + hw_crc.
+ *    Both families are carried: NT36672A (event 0x21C00, bld regs 0x3Fxxx,
+ *    hw_crc=1) and the no-flash family (event 0x11A00, boot_rdy 0x1F141,
+ *    hw_crc=0).
+ *  - Download (hw_crc=1): loop<=3 { bootloader_reset; write_firmware —
+ *    header end=LE32@0, ILM/DLM 12B entries, info secs 16B @0x30, partitions
+ *    sized+1, <=63KiB SRAM bursts {SRAM&0x7F|0x80,...}; set_bld_hw_crc
+ *    (ILM/DLM reg banks); bld_crc_enable (BLD_CRC_EN|=0x80); fw_crc_enable
+ *    (eventbuf RESET_COMPLETE=0, HOST_CMD=0xAE); boot_ready (BOOT_RDY=1);
+ *    check_fw_reset_state(INIT, <=10) }. hw_crc=0 prepends eng_reset, skips
+ *    the bld regs, adds POR_CD writes in boot_ready and a software CheckSum
+ *    compare at R_ILM_CHECKSUM.
+ *  - IRQ (EINT14 falling) -> 66B event read at event-buf page, byte0=0:
+ *    packet checksum buf[65] == ~sum(buf[1..64])+1; recovery if
+ *    buf[1..6]==0x77 (fw reset) or >10 consecutive all-{0xFD,0xFE} (WDT);
+ *    fingers at pos=1+6i: id=b>>3, state=b&7 (1 down/2 move/3 up),
+ *    x=b1<<4|b3>>4, y=b2<<4|b3&0xF. Buttons at buf[61..62] (0xF8 flag):
+ *    not implemented.
+ *
+ * ADT: reset-gpio (held high; the chip resets over SPI), max-x/max-y,
+ * fw-path, optional swrst-addr (default 0x03F0FE from the mt6833
+ * 672-family dtsi — the NF dtsi has no such prop; 0x01F01A and 0x01C0BE
+ * are tried automatically when the trim read fails).
+ */
+#include <IOKit/IOLib.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOWorkLoop.h>
+#include <IOKit/IOTimerEventSource.h>
+#include <IOKit/IOInterruptEventSource.h>
+
+#include <sys/fcntl.h>
+#include <sys/proc.h>
+#include <sys/vnode.h>
+extern "C" {
+#include <sys/vnode_internal.h>
+}
+#include <sys/uio.h>
+#include <vfs/vfs_support.h>
+
+#include "SweetHIDTouch.h"
+#include "../AthensSPI.h"
+#include "../VivaIO.h"
+
+#define NVT_DUMMY_BYTES   1
+#define NVT_TRANSFER_LEN  (63 * 1024)
+#define NVT_POINT_LEN     65          /* POINT_DATA_LEN */
+#define NVT_MAX_FINGERS   10
+#define NVT_TRIM_PAGE     0x1F64E
+#define NVT_ENG_RST       0x7FFF80
+#define NVT_RST_INIT      0xA0
+#define NVT_RST_MAX       0xAF
+#define NVT_SWRST_DFLT    0x03F0FE    /* mt6833 672-family dtsi value */
+#define NVT_RDFAST_DFLT   0x03F310    /* mt6833 dtsi spi-rd-fast-addr */
+
+/* event map offsets inside the EVENT_BUF page */
+enum {
+	EV_HOST_CMD = 0x50,
+	EV_RESET_COMPLETE = 0x60,
+	EV_FWINFO = 0x78,
+};
+
+struct nvt_map {
+	uint32_t event_buf, boot_rdy, por_cd;
+	uint32_t ilm_len, dlm_len, ilm_des, dlm_des;
+	uint32_t g_ilm, g_dlm, r_ilm, bld_crc_en;
+	uint32_t swrst, rdfast;
+	uint8_t  hw_crc;
+	const char *name;
+};
+
+/* NT36672A_memory_map (hw_crc=1) — 672-family flash-variant layout */
+static const struct nvt_map MAP_A = {
+	0x21C00, 0x3F10D, 0,
+	0x3F118, 0x3F130, 0x3F128, 0x3F12C,
+	0x3F100, 0x3F104, 0x3F120, 0x3F30E,
+	NVT_SWRST_DFLT, NVT_RDFAST_DFLT, 1, "nt36672a",
+};
+/* NT36525/NT36676F_memory_map (hw_crc=0) — small no-flash SRAM layout
+ * matching our firmware's partition SRAM addresses (0x000000-0x02B4A8) */
+static const struct nvt_map MAP_NF = {
+	0x11A00, 0x1F141, 0x1F61C,
+	0, 0, 0, 0,
+	0, 0, 0x1BF00, 0,
+	NVT_SWRST_DFLT, NVT_RDFAST_DFLT, 0, "noflash",
+};
+/* trim_id_table subset (masked id bytes -> map); first match wins.
+ * Only entries for 672-family and no-flash chips are kept. */
+static const struct { uint8_t id[6], mask[6]; const struct nvt_map *map; } TRIM[] = {
+	{ {0x0C,0xFF,0xFF,0x25,0x65,0x03}, {1,0,0,1,1,1}, &MAP_A },
+	{ {0x0B,0xFF,0xFF,0x25,0x65,0x03}, {1,0,0,1,1,1}, &MAP_A },
+	{ {0x0A,0xFF,0xFF,0x72,0x65,0x03}, {1,0,0,1,1,1}, &MAP_A },
+	{ {0x0A,0xFF,0xFF,0x82,0x66,0x03}, {1,0,0,1,1,1}, &MAP_A },
+	{ {0x0A,0xFF,0xFF,0x70,0x66,0x03}, {1,0,0,1,1,1}, &MAP_A },
+	{ {0x0B,0xFF,0xFF,0x70,0x66,0x03}, {1,0,0,1,1,1}, &MAP_A },
+	{ {0x0A,0xFF,0xFF,0x72,0x67,0x03}, {1,0,0,1,1,1}, &MAP_A },
+	{ {0xFF,0xFF,0xFF,0x25,0x65,0x03}, {0,0,0,1,1,1}, &MAP_A },
+	/* no-flash family (hw_crc=0) — last entry is the NT36676F-style
+	 * catch-all for IDs like xx xx xx 76 66 03 */
+	{ {0x55,0x00,0xFF,0x00,0x00,0x00}, {1,1,0,1,1,1}, &MAP_NF },
+	{ {0xAA,0x72,0xFF,0x00,0x00,0x00}, {1,1,0,1,1,1}, &MAP_NF },
+	{ {0xFF,0xFF,0xFF,0x72,0x66,0x03}, {0,0,0,1,1,1}, &MAP_NF },
+	{ {0xFF,0xFF,0xFF,0x70,0x66,0x03}, {0,0,0,1,1,1}, &MAP_NF },
+	{ {0xFF,0xFF,0xFF,0x70,0x67,0x03}, {0,0,0,1,1,1}, &MAP_NF },
+	{ {0xFF,0xFF,0xFF,0x76,0x66,0x03}, {0,0,0,1,1,1}, &MAP_NF },
+};
+
+struct nvt_part { uint32_t bin, sram, size, crc; };
+
