--- a/bsd/dev/arm/systemcalls.c	2026-11-15 03:50:58.525417400 +0530
+++ b/bsd/dev/arm/systemcalls.c	2026-11-15 03:51:14.693768600 +0530
@@ -41,6 +41,8 @@
