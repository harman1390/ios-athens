+	if (sweetuaf < 0) {
+		sweetuaf = 0;
+		PE_parse_boot_argn("sweetuaf", &sweetuaf, sizeof(sweetuaf));
+	}
+	if (sweetuaf == 1) {
+		memset((void *)elem, 0, size);
+		return;
+	}
 	(panic)("[%s%s]: element modified after free "
 	"(off:%d, val:0x%016lx, sz:%d, ptr:%p)%s",
 	zone_heap_name(z), zone_name(z),
