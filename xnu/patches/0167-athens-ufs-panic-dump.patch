Persist a panic record + the full corrupted element to the partition log
tail so recovery can read it after the log flusher dies with the panic.

diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -1,6 +1,28 @@
 	return os_atomic_load(&sweet_log_total, relaxed);
 }
 
+/* SWEET: persist a panic record to the partition's log tail so recovery can
+ * read it after the log flusher dies with the panic. ufs_scsi is polled, so
+ * this runs in panic context; the caller passes the panic tag + payload and we
+ * drop the host lock (the other CPUs are quiesced while the panic dumps run). */
+int
+sweet_ufs_panic_write(const char *tag, const void *data, size_t len)
+{
+	uint8_t *b = (uint8_t *)(su.dma + DMA_BOUNCE);
+	uint64_t base;
+	if (!su.ready || !su.writable || !su.dma || !su.nblocks) {
+		return -1;
+	}
+	base = su.first_block + su.nblocks - SWEET_LOG_BLOCKS;
+	if (len > BOUNCE_SIZE - UFS_BLOCK) {
+		len = BOUNCE_SIZE - UFS_BLOCK;
+	}
+	memcpy(b, "SWEETPAN", 8);
+	strlcpy((char *)b + 8, tag, UFS_BLOCK - 8);
+	memcpy(b + UFS_BLOCK, data, len);
+	return ufs_write_blocks(base, 1 + (uint32_t)((len + UFS_BLOCK - 1) / UFS_BLOCK));
+}
+
 struct sweet_log_header {
 	char magic[8];
 	uint32_t version, size;
