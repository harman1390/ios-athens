 	if (fInfraRegs != 0) {
-		*(volatile uint32_t *)(fInfraRegs + IFRAO4_CG_SET) = 1u << IFRAO_SPI4_BIT;
+		/* Enable the ifrao_spi4 clock gate. With mtk_clk_gate_ops_setclr a
+		 * CLR write enables (bit runs -> sta reads 0); a SET write gates it
+		 * off. Writing SET here would leave the whole SPI4 register block
+		 * clock-gated -> every read returns 0x00000000 and transfers no-op. */
+		volatile uint32_t *cg = (volatile uint32_t *)fInfraRegs;
+		uint32_t mask = 1u << IFRAO_SPI4_BIT;
+		cg[IFRAO4_CG_CLR / 4] = mask;
+		uint32_t sta = cg[IFRAO4_CG_STA / 4];
+		for (int i = 0; i < 8 && (sta & mask) != 0; i++) {
+			IODelay(100);
+			sta = cg[IFRAO4_CG_STA / 4];
+		}
+		IOLog("ATHENS SPI: ifrao_spi4 gate sta 0x%08x (%s)\n",
+			sta, (sta & mask) ? "STILL GATED" : "running");
 	}
