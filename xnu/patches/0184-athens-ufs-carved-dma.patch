--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -797,18 +797,43 @@
 	su.wait = (wait == 1);
 
 	su.regs = ml_io_map(reg[0], reg[1]);
-	/* A host without 64-bit addressing gets DMA memory below 4 GiB. */
-	ppnum_t max_pnum = (ppnum_t)(atop_64(1ULL << 32) - 1); /* always <4GiB: CAP read can lie early */
-	if (kmem_alloc_contig(kernel_map, &su.dma, DMA_SIZE, PAGE_MASK, max_pnum, 0,
-	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
-		printf("SWEET UFS: no contiguous DMA memory\n");
-		return ENOMEM;
+	/* athens: /sweet-ufs dma-phys is a carve taken off the top of DRAM by
+	 * mkadt.py, guaranteed free and mappable. Mapping it directly cannot hit
+	 * the contiguous-page search below, which is constrained to <4GiB and
+	 * fails under --highmem (all managed RAM is above 4 GiB) -> FindBSDRoot
+	 * ENOMEM panic (IOKitBSDInit.cpp:778). Absent on viva/qemu -> the old
+	 * path below is kept unchanged. */
+	uintptr_t const *dmareg = NULL;
+	unsigned int dmasz = 0;
+	uint64_t dma_phys = 0;
+	if (SecureDTGetProperty(node, "dma-phys", (void const **)&dmareg, &dmasz) == kSuccess &&
+	    dmasz >= sizeof(uintptr_t)) {
+		dma_phys = (uint64_t)dmareg[0];
 	}
-	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)su.dma);
-	if (!pn) {
-		return ENOMEM;
+	if (dma_phys) {
+		su.dma = (vm_offset_t)ml_io_map((vm_map_address_t)dma_phys, DMA_SIZE);
+		if (!su.dma) {
+			printf("SWEET UFS: carved DMA map failed at 0x%llx\n",
+			    (unsigned long long)dma_phys);
+			return ENOMEM;
+		}
+		su.dma_pa = dma_phys;
+		printf("SWEET UFS: carved DMA region at 0x%llx\n",
+		    (unsigned long long)dma_phys);
+	} else {
+		/* A host without 64-bit addressing gets DMA memory below 4 GiB. */
+		ppnum_t max_pnum = (ppnum_t)(atop_64(1ULL << 32) - 1); /* always <4GiB: CAP read can lie early */
+		if (kmem_alloc_contig(kernel_map, &su.dma, DMA_SIZE, PAGE_MASK, max_pnum, 0,
+		    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			printf("SWEET UFS: no contiguous DMA memory\n");
+			return ENOMEM;
+		}
+		ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)su.dma);
+		if (!pn) {
+			return ENOMEM;
+		}
+		su.dma_pa = ptoa_64(pn);
 	}
-	su.dma_pa = ptoa_64(pn);
 	su.secsize = DEV_BSIZE;
 	uint32_t lun_arg = UINT32_MAX;
 	PE_parse_boot_argn("ufslun", &lun_arg, sizeof(lun_arg));
