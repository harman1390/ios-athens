+/*
+ * First-grab zero check and never-used-page scanner (the split
+ * experiment for the stray-writer hunt).
+ *
+ * The shim scrubs [topOfKernelData, window end) to zero before entering
+ * XNU, so every managed page must still read all-zero until its first
+ * handout. sweet_fg_bits[] records which pages have ever left the free
+ * pool; sweet_first_grab() runs at every handout, dc-civacs the page
+ * (so a stale clean cache line cannot hide a non-coherent physical
+ * write) and scans all 16K - a nonzero word panics with the PA, the
+ * offset and the first bad values, before the new owner can write it.
+ * sweet_poolscan_thread() re-reads never-used free pages every ~100 ms
+ * and reports the PA, offset and time of the first change.
+ *
+ * A nonzero never-used page = a writer into free memory (bus master, or
+ * a CPU stale pointer); the PA/offset/timing then characterise it. If
+ * free pages stay zero while in-use pages corrupt, the bug is in an
+ * owner's code instead.
+ *
+ * vm_page_release() additionally tags used-then-freed pages with a
+ * self-describing poison pattern, so the scanner covers both
+ * populations: never-used pages (expected zero) and used-then-freed
+ * pages (expected poison).
+ *
+ * Boot args:
+ *   sweetzcheck=0   first-grab check off (default 1; panics on hit)
+ *   sweetscan=0     pool scanner off (default 1 report, 2 panic on hit)
+ *   sweetscan_n=N   pages scanned per ~100 ms tick (default 256)
+ *   sweetpoison=0   poison-on-free fill off (default 1)
+ */
+extern vm_map_address_t phystokv(pmap_paddr_t pa);  /* osfmk/arm64/arm_vm_init.c */
+extern void flush_dcache64(addr64_t addr, unsigned count, int phys); /* osfmk/arm/caches_internal.h */
+extern int sweet_ufs_diag_write(const char *tag, const void *data, size_t len); /* bsd/dev/sweet_ufs.c */
+
+#define SWEET_FG_MAX_PN	(1u << 18)			/* ppnums: PAs below 4 GiB */
+static uint32_t sweet_fg_bits[SWEET_FG_MAX_PN / 32];
+static uint32_t sweet_pz_bits[SWEET_FG_MAX_PN / 32];	/* "is poisoned now" */
+static int sweet_fg_mode = -1;
+
+/* Set the page's "has left the free pool" bit; returns its old value. */
+static bool
+sweet_fg_test_and_mark(ppnum_t pn)
+{
+	uint32_t bit = 1u << (pn & 31);
+
+	if (pn >= SWEET_FG_MAX_PN) {
+		return true;	/* outside the tracked window: never checked */
+	}
+	return (os_atomic_or_orig(&sweet_fg_bits[pn >> 5], bit, relaxed) & bit) != 0;
+}
+
+static bool
+sweet_fg_marked(ppnum_t pn)
+{
+	return pn >= SWEET_FG_MAX_PN ||
+	    (sweet_fg_bits[pn >> 5] & (1u << (pn & 31))) != 0;
+}
+
+/* Poison-on-free: a page that has ever been handed out gets a tagged
+ * pattern while it sits on a free queue (in vm_page_release below), so
+ * the scanner can catch stray writes into used-then-freed pages too,
+ * not just never-used ones. The pattern packs a magic, the ppnum and
+ * the qword index, so any mismatched word self-describes. */
+#define SWEET_POISON_TOP	0xf2ee000000000000ULL
+static inline uint64_t
+sweet_poison(ppnum_t pn, uint32_t i)
+{
+	return SWEET_POISON_TOP | ((uint64_t)(pn & 0xffff) << 16) | i;
+}
+
+static int sweet_poison_mode = -1;
+static void
+sweet_poison_page(ppnum_t pn)
+{
+	uint64_t *q = (uint64_t *)phystokv((pmap_paddr_t)ptoa_64(pn));
+
+	if (pn >= SWEET_FG_MAX_PN) {
+		return;
+	}
+	if (sweet_poison_mode < 0) {
+		sweet_poison_mode = 1;
+		PE_parse_boot_argn("sweetpoison", &sweet_poison_mode, sizeof(sweet_poison_mode));
+	}
+	for (unsigned int i = 0; i < PAGE_SIZE / sizeof(uint64_t); i++) {
+		q[i] = sweet_poison(pn, i);
+	}
+	/* Set the poisoned bit AFTER the fill: the scanner may check this
+	 * page only from this point on. */
+	os_atomic_or(&sweet_pz_bits[pn >> 5], 1u << (pn & 31), relaxed);
+}
+
+static bool
+sweet_poisoned(ppnum_t pn)
+{
+	return pn < SWEET_FG_MAX_PN &&
+	    (sweet_pz_bits[pn >> 5] & (1u << (pn & 31))) != 0;
+}
+
+static void
+sweet_depoison(ppnum_t pn)
+{
+	if (pn < SWEET_FG_MAX_PN) {
+		os_atomic_andnot(&sweet_pz_bits[pn >> 5], 1u << (pn & 31), relaxed);
+	}
+}
+
+/* Clean+invalidate the page to the point of coherency, then count
+ * words that differ from the expected fill (0, or the poison pattern
+ * when poisoned is set). *offp gets the offset of the first bad one,
+ * w0/w1 the first two bad values. */
+static unsigned int
+sweet_page_dirty(ppnum_t pn, pmap_paddr_t pa, bool poisoned,
+    uint32_t *offp, uint64_t *w0, uint64_t *w1)
+{
+	const uint64_t *q = (const uint64_t *)phystokv(pa);
+	unsigned int bad = 0;
+
+	*offp = ~0u;
+	*w0 = *w1 = 0;
+	flush_dcache64((addr64_t)pa, PAGE_SIZE, TRUE);
+	for (unsigned int i = 0; i < PAGE_SIZE / sizeof(uint64_t); i++) {
+		if (q[i] == (poisoned ? sweet_poison(pn, i) : 0)) {
+			continue;
+		}
+		if (*offp == ~0u) {
+			*offp = i * (uint32_t)sizeof(uint64_t);
+			*w0 = q[i];
+		} else if (bad == 1) {
+			*w1 = q[i];
+		}
+		bad++;
+	}
+	return bad;
+}
+
+/* The page is leaving the free pool. The first time it does it must
+ * still be shim-scrubbed to zero; panic otherwise. The bit is set even
+ * when the check is off so the pool scanner sees real use either way. */
+void
+sweet_first_grab_pn(ppnum_t pn)
+{
+	pmap_paddr_t pa;
+	uint32_t off;
+	uint64_t w0, w1;
+	unsigned int bad;
+
+	if (sweet_fg_mode < 0) {
+		sweet_fg_mode = 1;
+		PE_parse_boot_argn("sweetzcheck", &sweet_fg_mode, sizeof(sweet_fg_mode));
+	}
+	sweet_depoison(pn);
+	if (sweet_fg_test_and_mark(pn)) {
+		return;		/* a reuse: the content is an owner's data */
+	}
+	if (!sweet_fg_mode || fill) {
+		return;		/* fill= patterns free pages legitimately */
+	}
+	pa = (pmap_paddr_t)ptoa_64(pn);
+	bad = sweet_page_dirty(pn, pa, false, &off, &w0, &w1);
+	if (__improbable(bad)) {
+		printf("SWEET ZCHECK: pn 0x%x pa 0x%llx: %u nonzero qwords, "
+		    "first at +0x%x = 0x%016llx (second 0x%016llx)\n",
+		    pn, (unsigned long long)pa, bad, off, w0, w1);
+		{
+			char rec[256];
+			/* The console ring may never flush again after the panic,
+			 * so persist through the polled UFS path now. */
+			snprintf(rec, sizeof(rec),
+			    "ZCHECK pn 0x%x pa 0x%llx bad %u off +0x%x w0 0x%016llx w1 0x%016llx\n",
+			    pn, (unsigned long long)pa, bad, off, w0, w1);
+			sweet_ufs_diag_write("zcheck", rec, strlen(rec));
+		}
+		panic("SWEET ZCHECK: page was dirty before its first handout "
+		    "- stray write into the free pool");
+	}
+}
+
+static inline void
+sweet_first_grab(vm_page_t m)
+{
+	sweet_first_grab_pn(VM_PAGE_GET_PHYS_PAGE(m));
+}
+
+/* --- never-used free-page scanner --- */
+
+static int sweet_scan_mode = -1;
+static unsigned int sweet_scan_chunk = 1024;
+static uint64_t sweet_scan_hits;
+static int sweet_scan_chan;
+
+static bool
+sweet_scan_freeq(int q_state)
+{
+	return q_state == VM_PAGE_ON_FREE_Q ||
+	    q_state == VM_PAGE_ON_FREE_LOCAL_Q ||
+	    q_state == VM_PAGE_ON_FREE_LOPAGE_Q;
+}
+
+static void
+sweet_poolscan_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint32_t i = 0;
+	bool full_pass = true;	/* one complete sweep before ticking */
+
+	for (;;) {
+		uint64_t deadline;
+		nanoseconds_to_absolutetime(100 * NSEC_PER_MSEC, &deadline);
+		deadline += mach_absolute_time();
+		if (!full_pass) {
+			(void)assert_wait_deadline(&sweet_scan_chan, THREAD_UNINT, deadline);
+			thread_block(THREAD_CONTINUE_NULL);
+		}
+
+		for (unsigned int n = 0; n < sweet_scan_chunk; n++) {
+			ppnum_t pn;
+			pmap_paddr_t pa;
+			vm_page_t m;
+			uint32_t off;
+			uint64_t w0, w1;
+			unsigned int bad;
+			bool marked, poisoned, same_state;
+			int qs;
+
+			if (i >= vm_pages_count) {
+				i = 0;	/* wrap: sweep continuously */
+				full_pass = false;
+			}
+			m = &vm_pages[i++];
+			pn = VM_PAGE_GET_PHYS_PAGE(m);
+			marked = sweet_fg_marked(pn);
+			poisoned = sweet_poisoned(pn);
+			if (!sweet_scan_freeq(m->vmp_q_state) ||
+			    (marked && !poisoned)) {
+				/* a used page that was freed without going through
+				 * a poisoning release carries owner data and cannot
+				 * be checked - the poisoned bit makes a false hit
+				 * structurally impossible */
+				continue;
+			}
+			/* Two populations: unmarked pages must still be zero;
+			 * poisoned (used once, freed, tagged) pages must still
+			 * carry the poison pattern. Race-tolerant first look:
+			 * a page grabbed (and so depoisoned + written) mid-scan
+			 * is discarded by the locked re-check below. */
+			pa = (pmap_paddr_t)ptoa_64(pn);
+			bad = sweet_page_dirty(pn, pa, poisoned, &off, &w0, &w1);
+			if (!bad) {
+				continue;
+			}
+			vm_page_lock_queues();
+			qs = m->vmp_q_state;
+			same_state = sweet_scan_freeq(qs) &&
+			    (marked == sweet_fg_marked(pn)) &&
+			    (poisoned == sweet_poisoned(pn));
+			vm_page_unlock_queues();
+			if (!same_state) {
+				continue;
+			}
+			sweet_scan_hits++;
+			printf("SWEET POOLSCAN: %s free page pn 0x%x color %u "
+			    "qs %u pa 0x%llx: %u bad qwords, first at +0x%x = "
+			    "0x%016llx (second 0x%016llx), t=%llu abs (hit %llu)\n",
+			    marked ? "used-freed" : "never-used",
+			    pn, VM_PAGE_GET_COLOR(m), qs,
+			    (unsigned long long)pa, bad, off, w0, w1,
+			    (unsigned long long)mach_absolute_time(),
+			    (unsigned long long)sweet_scan_hits);
+			if (sweet_scan_hits <= 4) {
+				char rec[256];
+				/* Persist the first few hits through the polled UFS
+				 * path: a later panic can kill the ring flush. */
+				snprintf(rec, sizeof(rec),
+				    "POOLSCAN %s pn 0x%x qs %u color %u pa 0x%llx "
+				    "off +0x%x w0 0x%016llx w1 0x%016llx t %llu hit %llu\n",
+				    marked ? "used-freed" : "never-used",
+				    pn, qs, VM_PAGE_GET_COLOR(m),
+				    (unsigned long long)pa, off, w0, w1,
+				    (unsigned long long)mach_absolute_time(),
+				    (unsigned long long)sweet_scan_hits);
+				sweet_ufs_diag_write("poolscan", rec, strlen(rec));
+			}
+			if (sweet_scan_mode >= 2) {
+				panic("SWEET POOLSCAN: free page modified - "
+				    "stray writer into free memory");
+			}
+		}
+	}
+}
+
+void
+sweet_poolscan_start(void)
+{
+	thread_t thread;
+	static bool started;
+
+	if (started) {
+		return;
+	}
+	started = true;
+	if (sweet_scan_mode < 0) {
+		sweet_scan_mode = 1;
+		PE_parse_boot_argn("sweetscan", &sweet_scan_mode, sizeof(sweet_scan_mode));
+		PE_parse_boot_argn("sweetscan_n", &sweet_scan_chunk, sizeof(sweet_scan_chunk));
+		PE_parse_boot_argn("sweetpoison", &sweet_poison_mode, sizeof(sweet_poison_mode));
+		if (sweet_poison_mode < 0) {
+			sweet_poison_mode = 1;
+		}
+	}
+	if (!sweet_scan_mode || fill) {
+		return;
+	}
+	if (sweet_scan_chunk == 0) {
+		sweet_scan_chunk = 1;
+	}
+	if (kernel_thread_start(sweet_poolscan_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+		printf("SWEET POOLSCAN: armed - %u managed pages, %u pages/tick every 100 ms, "
+		    "max pn 0x%x (bitmap covers pn < 0x%x)\n",
+		    vm_pages_count, sweet_scan_chunk,
+		    vm_first_phys_ppnum + vm_pages_count - 1, SWEET_FG_MAX_PN - 1);
+	}
+}
