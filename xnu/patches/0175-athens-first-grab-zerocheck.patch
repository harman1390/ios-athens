+/* SWEET: ml_static_mfree ranges enter the free pool with live
+ * contents below topOfKernelData and are excluded from the never-used
+ * zero canary. Keep the ranges here so every diag record can carry
+ * the table - a hit PA is then classifiable without the console ring
+ * (early-boot lines are gone before the ring exists). */
+#define SWEET_SF_MAX 32
+struct sweet_sfree_range {
+	uint64_t va, size, pa_lo, pa_hi;
+};
+struct sweet_sfree_range sweet_sfree_ranges[SWEET_SF_MAX];
+unsigned int sweet_sfree_count;
+
+extern uint64_t avail_end;
+
+int
+sweet_staticfree_dump(char *buf, size_t len)
+{
+	int n = snprintf(buf, len, "STATICFREE n %u tokd 0x%llx aend 0x%llx\n",
+	    sweet_sfree_count,
+	    BootArgs ? (unsigned long long)BootArgs->topOfKernelData : 0,
+	    (unsigned long long)avail_end);
+	for (unsigned int i = 0; i < sweet_sfree_count && (size_t)n < len; i++) {
+		n += snprintf(buf + n, len - (size_t)n,
+		    "SF%u va 0x%llx sz 0x%llx pa 0x%llx..0x%llx\n", i,
+		    (unsigned long long)sweet_sfree_ranges[i].va,
+		    (unsigned long long)sweet_sfree_ranges[i].size,
+		    (unsigned long long)sweet_sfree_ranges[i].pa_lo,
+		    (unsigned long long)sweet_sfree_ranges[i].pa_hi);
+	}
+	return n;
+}
