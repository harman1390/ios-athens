athens (RMX2117, MT6853): point the early framebuffer console at LK's
measured framebuffer 0x77e20000 (atag,videolfb on the phone, 2026-11-06).
The containing 32MB block is 0x76000000; fb start sits 0x1e20000 into it,
leaving ~451 pixel-rows inside the mapped block for early text (the real
AppleCLCD service maps the full framebuffer later). Pitch stays 4352 bytes
(1088 px ARGB8888, the same MediaTek LK convention as viva) pending a
pitch readout from the panel variant.

diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 023086f..0000000 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -515,10 +515,10 @@ LEXT(start_first_cpu)
 
 #if defined(SWEET)
 	/* Stage 0: white 64x32 band, no stack or page tables needed. */
-	MOV64	x0, (0x7bc10000 + 2368 * 4352)	/* viva LK framebuffer, pitch 1088 px */
+	MOV64	x0, (0x77e20000 + 400 * 4352)	/* athens LK framebuffer, pitch 1088 px */
 	mov		w1, #-1
 	mov		x2, #32
 	mov		x4, #4352
@@ -680,14 +680,14 @@ Lkernelcache_base_found:
 
 #if defined(SWEET)
 	/*
-	 * Splash framebuffer: one 32MB Normal-NC block in the EXISTING V=P
+	 * Splash framebuffer: one 32MB Device block in the EXISTING V=P
 	 * L2 table. Both framebuffer and RAM use L1 index 0; another call to
 	 * create_bootstrap_mapping would replace the RAM L2 table.
 	 * SWEET uses 16K pages and all bring-up RAM is below 4GB, so the first
 	 * V=P L2 page is bootstrap_pagetables + 2*PGBYTES.
 	 */
-	MOV64	x10, 0x7a000000	/* 32MB block holding the viva framebuffer start */
+	MOV64	x10, 0x76000000	/* 32MB block holding the athens framebuffer start */
 	mov		x11, #(ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_DISABLE) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
 	orr		x11, x11, x10
 	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
diff --git a/osfmk/arm64/sweet_early.h b/osfmk/arm64/sweet_early.h
index 0000000..0000000 100644
--- a/osfmk/arm64/sweet_early.h
+++ b/osfmk/arm64/sweet_early.h
@@ -7,15 +7,15 @@
 #include <stdint.h>
 
 #if defined(SWEET)
 /*
- * viva (MT6781): LK's video-mode framebuffer, ARGB8888, pitch 1088 px. It is
- * not 32MB-aligned, so the early console maps only the L2 block holding its
- * start and uses the rows that fit inside that block. The block also covers
- * part of the TEE carve-out (0x7aa00000-), so it is mapped as Device memory:
- * no speculative reads into secure DRAM.
+ * athens (RMX2117, MT6853): LK's video-mode framebuffer at 0x77e20000,
+ * ARGB8888, pitch 1088 px (measured via /chosen/atag,videolfb). It is not
+ * 32MB-aligned: the early console maps the L2 block holding its start and
+ * uses the ~448 rows that fit before the block end (fb start + 0x1e20000).
+ * Mapped as Device memory like viva's (the block neighbours carve-outs).
  */
-#define SWEET_EARLY_FB_PHYS     0x7bc10000ULL
-#define SWEET_EARLY_FB_BLOCK    0x7a000000ULL
+#define SWEET_EARLY_FB_PHYS     0x77e20000ULL
+#define SWEET_EARLY_FB_BLOCK    0x76000000ULL
 #define SWEET_EARLY_FB_ROWBYTES 4352u
-#define SWEET_EARLY_FB_ROWS     948u
+#define SWEET_EARLY_FB_ROWS     448u
 void sweet_early_mark(unsigned int stage, const char *label);
 void sweet_early_putc(char c);
 void sweet_early_panic(const char *fmt, va_list *args);
