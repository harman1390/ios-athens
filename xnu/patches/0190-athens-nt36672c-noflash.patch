+/* nvt_eng_reset: engineering reset cmd to ENG_RST_ADDR (0x7FFF80) = 0x5A.
+ * Vendor sends this before TP_RESX is raised / before trim + download so the
+ * MCU starts from a known state. */
+void
+AthensNT36672C::engReset(void)
+{
+	writeAddr(NVT_ENG_RST, 0x5A);
+	IODelay(1000);                       /* tMCU_Idle2TP_REX_Hi after TP_RST */
+}
