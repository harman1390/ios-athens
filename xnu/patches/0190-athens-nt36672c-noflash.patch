+/* For hw_crc==0 the vendor no-flash maps disagree on EVENT_BUF
+ * (0x11A00 NT36525/NT36676F vs 0x11E00 NT36772). The download writes to
+ * absolute SRAM addresses so it is map-independent — only the status/touch
+ * reads use event_buf. If trim defaulted to the wrong page, the firmware can
+ * still be running; probe the sibling pages and lock in the one that answers
+ * RESET_COMPLETE. fMap points at fMapStore so the write is visible. */
+bool
+AthensNT36672C::discoverEventBuf(void)
+{
+	static const uint32_t cands[] = { 0x11A00, 0x11E00 };
+	uint32_t cur = fMap->event_buf;
+	for (uint32_t c = 0; c < sizeof(cands) / sizeof(cands[0]); c++) {
+		if (cands[c] == cur) {
+			continue;
+		}
+		fMapStore.event_buf = cands[c];
+		if (checkResetState(NVT_RST_INIT)) {
+			IOLog("ATHENS TOUCH: event_buf -> 0x%x (reset state ok)\n", cands[c]);
+			return true;
+		}
+	}
+	fMapStore.event_buf = cur;
+	return false;
+}
