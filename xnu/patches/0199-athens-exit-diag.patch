--- a/bsd/kern/kern_exit.c
+++ b/bsd/kern/kern_exit.c
@@ -1832,6 +1832,54 @@
 	}
 }
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+static char sweet_exit_names[128];
+static int sweet_exit_parsed;
+
+static bool
+sweet_exit_wanted(const char *name)
+{
+	size_t n = strlen(name);
+	for (const char *t = sweet_exit_names; *t;) {
+		const char *end = strchr(t, ',');
+		size_t tl = end ? (size_t)(end - t) : strlen(t);
+		if (tl == n && n > 0 && strncmp(t, name, n) == 0) {
+			return true;
+		}
+		if (!end) {
+			break;
+		}
+		t = end + 1;
+	}
+	return false;
+}
+
+static void
+sweet_exit_log(proc_t p, int rv)
+{
+	if (!sweet_exit_parsed) {
+		sweet_exit_parsed = 1;
+		if (!PE_parse_boot_argn("sweetexit", sweet_exit_names, sizeof(sweet_exit_names))) {
+			strlcpy(sweet_exit_names, "powerd,profiled,SpringBoard,backboardd", sizeof(sweet_exit_names));
+		}
+	}
+	if (!sweet_exit_wanted(p->p_comm)) {
+		return;
+	}
+	if (PROC_HAS_EXITREASON(p)) {
+		char *desc = exit_reason_get_string_desc(p->p_exit_reason);
+		printf("SWEET EXIT %s[%d] sig %d status 0x%x reason ns %u code 0x%llx desc %s\n",
+		    p->p_comm, proc_getpid(p), WTERMSIG(rv), WEXITSTATUS(rv),
+		    p->p_exit_reason->osr_namespace,
+		    (unsigned long long)p->p_exit_reason->osr_code,
+		    desc != NULL ? desc : "none");
+	} else {
+		printf("SWEET EXIT %s[%d] sig %d status 0x%x no-reason\n",
+		    p->p_comm, proc_getpid(p), WTERMSIG(rv), WEXITSTATUS(rv));
+	}
+}
+#endif
+
 void
 proc_prepareexit(proc_t p, int rv, boolean_t perf_notify)
 {
@@ -1845,6 +1893,10 @@
 	int kr = 0;
 	int create_corpse = FALSE;
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	sweet_exit_log(p, rv);
+#endif
+
 	if (p->p_crash_behavior != 0 || p == initproc) {
 		proc_handle_critical_exit(p, rv);
 	}
