- * 0x11) bit 0x40. Voltage is set first like the regulator framework does. */
+/* Power the NT36672C chip before the first SPI touch access.
+ *
+ * The chip is a shared display+touch die: its touch MCU runs on the same
+ * core that the LCM/display power domain supplies. iOS has no LCM driver,
+ * so the panel power GPIOs are never driven and the chip core stays off ->
+ * every SPI read returns 0x00 (recovery proves the part is fine once
+ * powered). vtp = MT6360 LDO2 is only the touch I/O rail; the chip also
+ * needs the panel rails. Replicates the LCM power-on (panel DTB
+ * dsi@14013000/panel3@0+panel4@0 gpios and the nt36672c lcm_init sequence):
+ *   vtp (i2c5 slave 0x64) -> pm-enable(41) lcd-1p8(136) bias(137,138) high
+ *   -> reset(86) 0-15-1-1-0-10-1-10 ms, idling out of reset (high).
+ */
 static void
-athens_touch_power(void)
+athens_touch_power(VivaGPIO *gpio)
 {
+	/* --- MT6360 LDO2 "vtp" (touch I/O, 1.8 V) over i2c5 slave 0x64 --- */
 	uint8_t v = 0, vv = 0x40;
 	if (mt6360_ldo_xfer(0x15, false, &vv) == 0) {
 		IOLog("ATHENS TOUCH: MT6360 LDO2 vout reg=0x%02x\n", vv);
@@ -809,6 +818,28 @@ athens_touch_power(void)
 		v |= 0x40;
 		mt6360_ldo_xfer(0x11, true, &v);
 	}
+	/* verify the enable actually latched (the write path is otherwise
+	 * unproven - a silent NAK would leave vtp off). */
+	uint8_t rb = 0;
+	if (mt6360_ldo_xfer(0x11, false, &rb) == 0) {
+		IOLog("ATHENS TOUCH: MT6360 LDO2 enable readback=0x%02x%s\n",
+		    rb, (rb & 0x40) ? " (on)" : " (STILL OFF)");
+	}
+
+	/* --- NT36672C chip rails (panel power GPIOs, all active-high) --- */
+	static const uint32_t rails[] = { 41, 136, 137, 138 };
+	for (unsigned i = 0; i < sizeof(rails) / sizeof(rails[0]); i++) {
+		gpio->setPinFunc(rails[i], 0);
+		gpio->setOutput(rails[i], true);
+	}
+	IOSleep(5);
+
+	/* --- panel reset(86), LCM lcm_init sequence; ends out of reset --- */
+	gpio->setPinFunc(86, 0);
+	gpio->setOutput(86, false); IOSleep(15);
+	gpio->setOutput(86, true);  IOSleep(1);
+	gpio->setOutput(86, false); IOSleep(10);
+	gpio->setOutput(86, true);  IOSleep(10);
 }
 
