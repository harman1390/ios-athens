diff --git a/iokit/Kernel/arm/SweetSEP.cpp b/iokit/Kernel/arm/SweetSEP.cpp
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/iokit/Kernel/arm/SweetSEP.cpp
@@ -0,0 +1,146 @@
+/*
+ * Built-in SEP (Secure Enclave) stub for SWEET: publishes an
+ * AppleSEPManager service + AppleSEPUserClient that launchd's
+ * data-protection boot tasks (seputil, keybagd) open and handshake
+ * through, so they initialize instead of exiting and panicking a
+ * mandatory task.
+ *
+ * Apple's closed AppleSEPManager kext attaches at IODeviceTree:/arm-io/sep
+ * and publishes the AppleSEPManager service; seputil does
+ * IORegistryEntryFromPath("IODeviceTree:/arm-io/sep") and/or
+ * IOServiceGetMatchingService("AppleSEPManager"), opens an
+ * AppleSEPUserClient and handshakes via IOConnectCall*.
+ *
+ * This pass registers the service on the arm-io DT node and logs EVERY
+ * selector/argument so the real handshake protocol is observed from the
+ * console, not guessed. Selectors return success with plausible data;
+ * iterate on the log.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <IOKit/IODeviceTreeSupport.h>
+#include <IOKit/IORegistryEntry.h>
+#include <libkern/c++/OSPtr.h>
+#include <libkern/c++/OSString.h>
+#include <sys/proc.h>
+
+class AppleSEPManager : public IOService {
+	OSDeclareDefaultStructors(AppleSEPManager);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleSEPManager, IOService);
+
+bool
+AppleSEPManager::start(IOService *provider)
+{
+	IORegistryEntry *armio = IORegistryEntry::fromPath(
+	    "IODeviceTree:/arm-io", gIODTPlane);
+	if (armio != NULL) {
+		setName("sep");
+		if (!attachToParent(armio, gIODTPlane)) {
+			IOLog("SWEET SEP: attachToParent(arm-io) failed\n");
+		}
+		armio->release();
+	}
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "AppleSEPUserClient");
+	registerService();
+	IOLog("SWEET SEP: AppleSEPManager registered (stub)\n");
+	return true;
+}
+
+class AppleSEPUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(AppleSEPUserClient);
+
+public:
+	bool initWithTask(task_t owningTask, void *securityToken,
+	    uint32_t type) APPLE_KEXT_OVERRIDE;
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleSEPUserClient, IOUserClient);
+
+bool
+AppleSEPUserClient::initWithTask(task_t owningTask, void *securityToken,
+    uint32_t type)
+{
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	IOLog("SWEET SEP: %s open type %u\n", name, type);
+	return IOUserClient::initWithTask(owningTask, securityToken, type);
+}
+
+IOReturn
+AppleSEPUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+static IOReturn
+sweet_sep_struct_out(IOExternalMethodArguments *args, const void *buf, uint32_t len)
+{
+	if (args->structureOutputDescriptor != NULL) {
+		if (len > args->structureOutputDescriptor->getLength()) {
+			return kIOReturnNoSpace;
+		}
+		args->structureOutputDescriptor->writeBytes(0, buf, len);
+		args->structureOutputDescriptorSize = len;
+		return kIOReturnSuccess;
+	}
+	if (args->structureOutput == NULL || len > args->structureOutputSize) {
+		return kIOReturnNoSpace;
+	}
+	memcpy(args->structureOutput, buf, len);
+	args->structureOutputSize = len;
+	return kIOReturnSuccess;
+}
+
+IOReturn
+AppleSEPUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference)
+{
+	IOReturn ret = kIOReturnSuccess;
+	uint32_t in_scalars = args->scalarInputCount;
+	uint32_t in_struct = args->structureInputDescriptor != NULL ?
+	    (uint32_t)args->structureInputDescriptor->getLength() : args->structureInputSize;
+	uint32_t out_scalars = args->scalarOutputCount;
+	uint32_t out_struct = args->structureOutputDescriptor != NULL ?
+	    (uint32_t)args->structureOutputDescriptor->getLength() : args->structureOutputSize;
+	uint64_t arg0 = in_scalars > 0 ? args->scalarInput[0] : 0;
+
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	IOLog("SWEET SEP: %s sel %u arg0 %llu in %u/%u out %u/%u\n", name, selector,
+	    arg0, in_scalars, in_struct, out_scalars, out_struct);
+
+	/* Answer with a plausible initialized block so seputil's handshake
+	 * checks pass; everything else success/unsupported, all logged. */
+	switch (selector) {
+	default:
+		if (out_struct > 0) {
+			static const uint8_t hs[64] = { 0 };
+			ret = sweet_sep_struct_out(args, hs, out_struct < 64 ? out_struct : 64);
+		} else if (out_scalars > 0) {
+			args->scalarOutput[0] = 0;
+			args->scalarOutputCount = 1;
+		}
+		break;
+	}
+	return ret;
+}
+#endif /* SWEET */

