Assert at allocation time instead of detection time. Every zone panic so
far fired long after the stray write; these checks panic at the point a
page is handed to a new owner while an old owner can still see it.

* osfmk/arm/pmap/pmap.c pmap_next_page() - panic if the returned PA is
  below BootArgs->topOfKernelData (inside the kernel/ADT/boot_args/
  ramdisk carve), at or past avail_end (out of the managed window, which
  covers the panic-log region above dram-size), or out of sequence
  (first_avail is strictly increasing; a repeat means a page can be
  handed out twice).
* osfmk/vm/vm_resident.c - SWEET_CHECK_HANDOUT(mem) at every
  vm_page_grab_options() return: panic if the page's vmp_q_state is not
  VM_PAGE_NOT_ON_Q or vmp_wire_count is nonzero at handout.
  sweet_check_zone_pages() verifies each page a zone just obtained is
  wired and on no VM queue.
* osfmk/kern/zalloc.c - call sweet_check_zone_pages() after the
  kmem_alloc in zone_fill_initially() and zone_allocate_va_locked().

diff --git a/osfmk/arm/pmap/pmap.c b/osfmk/arm/pmap/pmap.c
index 584ee38..bd5be94 100644
--- a/osfmk/arm/pmap/pmap.c
+++ b/osfmk/arm/pmap/pmap.c
@@ -2647,6 +2647,29 @@ pmap_next_page(
 		first_avail += PAGE_SIZE;
 		assert(avail_page_count > 0);
 		--avail_page_count;
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+		{
+			static pmap_paddr_t sweet_pool_next;
+			pmap_paddr_t pa = (pmap_paddr_t)ptoa(*pnum);
+
+			/* SWEET corruption hunt: the bootstrap pool carves
+			 * strictly upward from topOfKernelData. A PA below
+			 * it lands in the kernel/ADT/boot_args/ramdisk
+			 * carve; a gap in the sequence means first_avail
+			 * was reset and pages can be handed out twice. */
+			if (__improbable(pa < BootArgs->topOfKernelData ||
+			    pa + PAGE_SIZE > avail_end ||
+			    (sweet_pool_next && pa != sweet_pool_next))) {
+				panic("SWEET pmap_next_page: pa 0x%llx outside bootstrap pool "
+				    "(topOfKernelData 0x%llx avail_end 0x%llx expected 0x%llx)",
+				    (unsigned long long)pa,
+				    (unsigned long long)BootArgs->topOfKernelData,
+				    (unsigned long long)avail_end,
+				    (unsigned long long)sweet_pool_next);
+			}
+			sweet_pool_next = pa + PAGE_SIZE;
+		}
+#endif
 		return TRUE;
 	}
 	assert(avail_page_count == 0);
