diff --git a/osfmk/vm/vm_resident.c b/osfmk/vm/vm_resident.c
index 2666be8..e73660a 100644
--- a/osfmk/vm/vm_resident.c
+++ b/osfmk/vm/vm_resident.c
@@ -1042,6 +1042,47 @@ sweet_layout_dump(uint64_t elem_pa)
 		}
