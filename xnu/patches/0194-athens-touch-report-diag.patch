+	/* diag: log the first valid touch reports so touch can be confirmed
+	 * from the sweetlog without needing the GUI on screen. */
+	if (map != 0 && fDbgReports < 24) {
+		uint32_t x = 0, y = 0;
+		for (uint32_t i = 0; i < NVT_MAX_FINGERS; i++) {
+			uint32_t pos = 1 + 6 * i;
+			uint8_t id = pd[pos] >> 3, st = pd[pos] & 7;
+			if (id == 0 || id > NVT_MAX_FINGERS || (st != 1 && st != 2)) continue;
+			x = (pd[pos + 1] << 4) | (pd[pos + 3] >> 4);
+			y = (pd[pos + 2] << 4) | (pd[pos + 3] & 0x0F);
+			break;
+		}
+		IOLog("ATHENS TOUCH: report %u fingers map 0x%x first x=%u y=%u\n",
+		    fDbgReports, map, x, y);
+		fDbgReports++;
+	}
